 fi;
 if (( ${#fp_ppc[@]} > 0 )); then
 ifs-f90nml -i -g NAMPPC "${fp_ppc[@]}" $fort4;
 fi
}
BASH_FUNC_ocean_check_opts%%=() {  utstep=${utstep:?};
 if [[ $nemo -eq 0 && $fesom -eq 0 ]]; then
 nfrco=0;
 else
 nfrco=$(($coupfreq/utstep));
 fi;
 attr="${attr}nfrco=$nfrco ";
 ice_cpl_type_supported_options=(fractional thickness thermodynamical);
 if [[ ! " ${ice_cpl_type_supported_options[*]} " =~ [[:space:]]${ice_cpl_type}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --ice-cpl-type: ${ice_cpl_type}, supported options are: ${ice_cpl_type_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 ice_cpl_albedo_supported_options=(true false);
 if [[ ! " ${ice_cpl_albedo_supported_options[*]} " =~ [[:space:]]${ice_cpl_albedo}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --ice-cpl-albedo: ${ice_cpl_albedo}, supported options are: ${ice_cpl_albedo_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 nemo_check_opts
}
