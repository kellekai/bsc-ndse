BASH_FUNC_multio_ifs_plan_defaults%%=() {  resol=${resol:?};
 multio_ifs_model=${multio_ifs_model:?};
 experiment=${experiment:?};
 generation=${generation:?};
 activity=${activity:?};
 realization=${realization:?};
 resolution=${resolution:?};
 multio_plans_root=${multio_plans_root:?};
 local_env=();
 local_env+=(-v "IFS_GRID=O$((resol+1))");
 local_env+=(-v "MODEL=${multio_ifs_model}");
 local_env+=(-v "EXPERIMENT=$experiment");
 local_env+=(-v "GENERATION=$generation");
 local_env+=(-v "ACTIVITY=$activity");
 local_env+=(-v "REALIZATION=$realization");
 local_env+=(-v "RESOLUTION=$resolution");
 local_env+=(-v "MULTIO_PLANS_PATH=${multio_plans_root}/climate-dt");
 local_env+=(-v "ENABLE_SINK_FILE=0");
 local_env+=(-v "ENABLE_SINK_FDB=1");
 local_env+=(-v "MULTIO_ENCODE_CACHED=1");
 local_env+=(-v "NATIVE_PLANS_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_ENABLED=1");
 if [[ $resol == 79 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H32_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=0");
 else
 if [[ $resol == 399 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=0");
 else
 if [[ $resol == 1279 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_GRID=H512_nested");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=1");
 else
 if [[ $resol == 2559 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_GRID=H1024_nested");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=1");
 fi;
 fi;
 fi;
 fi;
 echo "${local_env[@]}"
}
