 if [[ "$purge_namcver" == true || "$cver_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMCVER $fort4;
 fi;
 if [[ "${cver_template}" != "undef" ]]; then
 \cat ${cver_template} >> $fort4;
 fi;
 if (( ${#in_cver[@]} > 0 )); then
 ifs-f90nml -i -g NAMCVER "${in_cver[@]}" $fort4;
 fi
}
BASH_FUNC_multio_setup_optimizations%%=() {  if [[ $use_multio_ifs != true && $use_multio_ocean != true ]]; then
 return;
 fi;
 rundir=${rundir:?};
 local opt_args=();
 if [[ $multio_server_distribution != "undef" ]]; then
 opt_args+=(--server-distribution "$multio_server_distribution");
 fi;
 if [[ $multio_mpi_pool_size != "undef" ]]; then
 opt_args+=(--mpi-pool-size "$multio_mpi_pool_size");
 fi;
 if [[ $multio_server_mpi_pool_size != "undef" ]]; then
 opt_args+=(--server-mpi-pool-size "$multio_server_mpi_pool_size");
 fi;
 if [[ $multio_client_mpi_pool_size != "undef" ]]; then
 opt_args+=(--client-mpi-pool-size "$multio_client_mpi_pool_size");
 fi;
 if [[ $multio_mpi_buffer_size != "undef" ]]; then
 opt_args+=(--mpi-buffer-size "$multio_mpi_buffer_size");
 fi;
 if [[ $multio_server_mpi_buffer_size != "undef" ]]; then
 opt_args+=(--server-mpi-buffer-size "$multio_server_mpi_buffer_size");
 fi;
 if [[ $multio_client_mpi_buffer_size != "undef" ]]; then
 opt_args+=(--client-mpi-buffer-size "$multio_client_mpi_buffer_size");
 fi;
 if [[ $multio_message_queue_size != "undef" ]]; then
 opt_args+=(--message-queue-size "$multio_message_queue_size");
 fi;
 if [[ ${#opt_args[@]} -eq 0 ]]; then
 return;
 fi;
 multio_optimization_option --output-directory "$rundir" "${opt_args[@]}"
}
BASH_FUNC_fesom_apply_custom_namelist_edits%%=() {  local this_namelist_edit target_namelist section assignment edit;
 for this_namelist_edit in "${fesom_namelist_edit[@]}";
 do
 target_namelist=${this_namelist_edit%%:*};
 edit=${this_namelist_edit#*:};
 section=${edit%%/*};
 assignment=${edit#*/};
 if [[ "${target_namelist}" == "${this_namelist_edit}" || "${section}" == "${edit}" ]]; then
 echo "${cmd}: (Error) Malformed --fesom-namelist-edit \"${this_namelist_edit}\", expected file:section/variable=value" 1>&2;
 ((errcnt += 1));
 continue;
 fi;
 if [[ ! " ${fesom_namelists[*]} " == *" ${target_namelist} "* ]]; then
 echo "${cmd}: (Error) --fesom-namelist-edit target \"${target_namelist}\" is not a known FESOM namelist" 1>&2;
 ((errcnt += 1));
 continue;
 fi;
 ifs-f90nml -i -g "${section}" -v "${assignment}" "${target_namelist}" || { 
 echo "${cmd}: (Error) Failed to apply namelist edit: \"ifs-f90nml -i -g ${section} -v ${assignment} ${target_namelist}\"" 1>&2;
 ((errcnt += 1))
 };
 done
}
BASH_FUNC_nemo_setup_files%%=() {  inprootnam=${inprootnam:?};
 if [[ $nemo -ne 1 ]]; then
 return;
 fi;
 if [[ $nemover = V40 ]]; then
 namelists_nemo_ref="namelist_ref namelist_ice_ref";
 namelist_nemo_ocean="namelist_cfg";
 namelist_nemo_seaice="namelist_ice_cfg";
 else
 echo "${cmd}: (Error) Unsupported NEMO model version: $nemover";
 ((errcnt += 1));
 fi;
 remap=$DATA/remap/nemo/${nemover}/${nemo_grid};
 if [[ ! -d $remap ]]; then
 if [[ "$trunc" = tco ]]; then
 echo "${cmd}: (Error) Unable to locate remap-dir $remap needed by NEMO : use --no-nemo to run without NEMO" 1>&2;
 ((errcnt += 1));
 else
 echo "${cmd}: (Warning) Unable to locate remap-dir $remap -- turning NEMO off" 1>&2;
 nemo=0;
 attr="${attr}nemo=0 ";
 unset remap;
 fi;
 fi;
 \ln -s $remap remap;
 ocedirconst=$INPROOT/nemo/${nemover}/${nemo_grid}/common/;
 ocedirdate=$INPROOT/nemo/${nemover}/${nemo_grid}/$YYYYMMDDZZ/;
 if [[ ! -d $ocedirconst ]]; then
 echo "${cmd}: (Error) Constant ocean data directory $ocedirconst is missing";
 ((errcnt += 1));
 fi;
 if [[ ! -d $ocedirdate ]]; then
 echo "${cmd}: (Error) Date specific ocean data directory $ocedirdate is missing";
 ((errcnt += 1));
 fi;
 for f in $ocedirconst/*.nc;
 do
 [[ -e "$f" ]] || break;
 b=$(basename $f);
 if [[ ! -f $b ]]; then
 \ln -s $ocedirconst/$b $b;
 fi;
 done;
 for f in $ocedirdate/*.nc;
 do
 [[ -e "$f" ]] || break;
 b=$(basename $f);
 if [[ ! -f $b ]]; then
 \ln -s $ocedirdate/$b $b;
 fi;
 done;
 if [[ $inprootnam -eq 0 ]]; then
 RAPS_NAMDIR_NEMO="${RAPS_ETCDIR}/nam/${RAPS_IFS_CYCLE}/nemo/${nemover}/${nemo_grid}";
 for this_namelist in ${namelists_nemo_ref} ${namelist_nemo_ocean} ${namelist_nemo_seaice};
 do
 [[ -L "${this_namelist}" ]] && unlink "${this_namelist}";
 if [[ ! -f "${RAPS_NAMDIR_NEMO}/${this_namelist}" ]]; then
 echo "${cmd}: (Error) Unable to locate NEMO namelist ${this_namelist} in ${RAPS_NAMDIR_NEMO}" 1>&2;
 ((errcnt += 1));
 fi;
 \cp -f ${RAPS_NAMDIR_NEMO}/${this_namelist} .;
 done;
 else
 for this_namelist in ${namelists_nemo_ref} ${namelist_nemo_ocean} ${namelist_nemo_seaice};
 do
 if [[ -f $ocedirdate/${this_namelist} ]]; then
 \cp $ocedirdate/${this_namelist} ${this_namelist};
 else
 if [[ -f $ocedirconst/${this_namelist} ]]; then
 \cp $ocedirconst/${this_namelist} ${this_namelist};
 else
 echo "${cmd}: (Error) Nemo namelist ${this_namelist} is missing! Tried ocean data directories $ocedirconst and $ocedirdate";
 ((errcnt += 1));
 fi;
 fi;
 done;
 fi;
 if [[ "${nemo_oce_restart}" = "undef" ]]; then
 if [[ ! -f restart.nc ]]; then
 echo "${cmd}: (Error) Missing NEMO ocean restart: --nemo-oce-restart has not been set, and there is no 'restart.nc' in INPROOT." 1>&2;
 ((errcnt += 1));
 fi;
 else
 [[ -f restart.nc ]] && rm -f restart.nc;
 if [[ ! -f ${nemo_oce_restart} ]]; then
 echo "${cmd}: (Error) Missing NEMO ocean restart: --nemo-oce-restart=${nemo_oce_restart} does not point to a file." 1>&2;
 ((errcnt += 1));
 fi;
 ln -s ${nemo_oce_restart} restart.nc;
 fi;
 if [[ "${nemo_ice_restart}" = "undef" ]]; then
 if [[ ! -f restart_ice_in.nc ]]; then
 echo "${cmd}: (Error) Missing NEMO/SI3 sea-ice restart: --nemo-ice-restart has not been set, and there is no 'restart_ice_in.nc' in INPROOT." 1>&2;
 ((errcnt += 1));
 fi;
 else
 [[ -f restart_ice_in.nc ]] && rm -f restart_ice_in.nc;
 if [[ ! -f ${nemo_ice_restart} ]]; then
 echo "${cmd}: (Error) Missing NEMO/SI3 sea-ice restart: --nemo-ice-restart=${nemo_ice_restart} does not point to a file." 1>&2;
 ((errcnt += 1));
 fi;
 ln -s ${nemo_ice_restart} restart_ice_in.nc;
 fi
}
BASH_FUNC_ifs_namelist_assemble_namcompo_emis%%=() {  fort4=${fort4:?};
 if [[ "$purge_namcompo_emis" == true || "$compo_emis_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMCOMPO_EMIS $fort4;
 fi;
 if [[ "${compo_emis_template}" != "undef" ]]; then
 \cat ${compo_emis_template} >> $fort4;
 fi;
 if (( ${#in_compo_emis[@]} > 0 )); then
 ifs-f90nml -i -g NAMCOMPO_EMIS "${in_compo_emis[@]}" $fort4;
 fi
}
BASH_FUNC_module_purge%%=() {  echo "+ module purge";
 module purge
}
BASH_FUNC_ifs_namelist_assemble_naeaer%%=() {  fort4=${fort4:?};
 if [[ "$purge_naeaer" == true || "$naeaer_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAEAER $fort4;
 fi;
 if [[ "${naeaer_template}" != "undef" ]]; then
 \cat ${naeaer_template} >> $fort4;
 fi;
 if (( ${#in_naeaer[@]} > 0 )); then
 ifs-f90nml -i -g NAEAER "${in_naeaer[@]}" $fort4;
 fi
}
BASH_FUNC_ifs_namelist_assemble_namgem%%=() {  fort4=${fort4:?};
 if [[ "$purge_namgem" == true || "$gem_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMGEM $fort4;
 fi;
 if [[ "${gem_template}" != "undef" ]]; then
 \cat ${gem_template} >> $fort4;
 fi;
 if (( ${#in_gem[@]} > 0 )); then
 ifs-f90nml -i -g NAMGEM "${in_gem[@]}" $fort4;
 fi
}
BASH_FUNC_contains_var%%=() {  [[ $1 =~ (^|[[:space:]])$2= ]] && return 0 || return 1
}
BASH_FUNC_nemo_setup_namelists%%=() {  bench=${bench:?};
 resol=${resol:?};
 gtype=${gtype:?};
 restart_directory=${restart_directory:?};
 runroot=${runroot:?};
 tasks=${tasks:?};
 yyyymmddzz=${yyyymmddzz:?};
 if [[ $nemo -ne 1 ]]; then
 return;
 fi;
 \cp -f ${namelist_nemo_ocean} "${namelist_nemo_ocean}.orig";
 \cp -f ${namelist_nemo_seaice} "${namelist_nemo_seaice}.orig";
 \cp -f namnemocoup.in namnemocoup.in.orig;
 \cp -f namnemowamcoup.in namnemowamcoup.in.orig;
 v_namcoupcommon=();
 if [[ ${nemorwdist} -eq 0 ]]; then
 v_namcoupcommon+=(-v "lwritedist=.false.");
 v_namcoupcommon+=(-v "lreaddist=.false.");
 else
 v_namcoupcommon+=(-v "lwritedist=.true.");
 v_namcoupcommon+=(-v "lreaddist=.true.");
 distdir=$runroot/$bench/parinter_${nemo_grid}_${tasks}_${nemoxproc}x${nemoyproc};
 mkdir -p $distdir;
 v_namcoupcommon+=(-v "cdpathdist=${distdir}");
 fi;
 [[ ${nemoreadchunk} -gt 0 ]] && v_namcoupcommon+=(-v "nremapreadchunk=${nemoreadchunk}");
 v_namnemocoup=("${v_namcoupcommon[@]}");
 v_namnemowamcoup=("${v_namcoupcommon[@]}");
 gridtypes=('T' 'U' 'V');
 for this_gridtype in "${gridtypes[@]}";
 do
 v_namnemocoup+=(-v "cdfile_gauss_to_${this_gridtype}='./remap/remap_${resol}${gtype}_mask_to_${nemo_full_grid}_mask_${this_gridtype}_L1.nc'");
 v_namnemowamcoup+=(-v "cdfile_wam_to_${this_gridtype}='./remap/remap_wam_ifs_${resol}${gtype}_mask_to_${nemo_full_grid}_mask_${this_gridtype}_L1.nc'");
 done;
 v_namnemocoup+=(-v "cdfile_T_to_gauss='./remap/remap_${nemo_full_grid}_mask_T_L1_to_${resol}${gtype}_mask.nc'");
 v_namnemowamcoup+=(-v "cdfile_T_to_wam='./remap/remap_${nemo_full_grid}_mask_T_L1_to_wam_ifs_${resol}${gtype}_mask.nc'");
 ifs-f90nml -i -g namnemocoup "${v_namnemocoup[@]}" namnemocoup.in;
 ifs-f90nml -i -g namnemowamcoup "${v_namnemowamcoup[@]}" namnemowamcoup.in;
 v_namdom=(-v "rn_rdt=${nemo_time_step}");
 ifs-f90nml -i -g namdom "${v_namdom[@]}" ${namelist_nemo_ocean};
 v_nammpp=(-v "jpni=${nemoxproc}" -v "jpnj=${nemoyproc}");
 ifs-f90nml -i -g nammpp "${v_nammpp[@]}" ${namelist_nemo_ocean};
 nemo_start_date=${yyyymmddzz:0:8};
 nemo_start_time=${yyyymmddzz:8:2};
 nemorcf_file="$restart_directory/nemorcf";
 if [[ -f "$nemorcf_file" ]]; then
 read -r nemo_next_chunk_step0_chunk < "$nemorcf_file";
 nemo_next_chunk_step0_chunk=$((nemo_next_chunk_step0_chunk + 1));
 else
 nemo_next_chunk_step0_chunk=1;
 fi;
 v_namrun=(-v "cn_exp=${EXPVER}" -v "nn_itend=${nn_itend}" -v "nn_date0=${nemo_start_date}" -v "nn_date0_multio=${nemo_start_date}" -v "nn_time0=${nemo_start_time}" -v "nn_time0_multio=${nemo_start_time}" -v "nn_step0_multio=${nemo_next_chunk_step0_chunk}");
 ifs-f90nml -i -g namrun "${v_namrun[@]}" ${namelist_nemo_ocean};
 ifs-f90nml -i -g namobs -v "ln_grid_search_lookup=${xypos}" ${namelist_nemo_ocean};
 if [[ "$nemo_ice_albedos" != "undef" ]]; then
 if [[ "$nemo_ice_albedos" = "48r1" ]]; then
 valb="-v rn_alb_dpnd=0.27                   -v rn_alb_idry=0.60                   -v rn_alb_imlt=0.58                   -v rn_alb_sdry=0.85                   -v rn_alb_smlt=0.75";
 else
 if [[ "$nemo_ice_albedos" = "48r2" ]]; then
 valb="-v rn_alb_dpnd=0.37                   -v rn_alb_idry=0.67                   -v rn_alb_imlt=0.58                   -v rn_alb_sdry=0.87                   -v rn_alb_smlt=0.80";
 else
 if [[ "$nemo_ice_albedos" = "era6" ]]; then
 valb="-v rn_alb_dpnd=0.30                   -v rn_alb_idry=0.60                   -v rn_alb_imlt=0.58                   -v rn_alb_sdry=0.80                   -v rn_alb_smlt=0.78";
 fi;
 fi;
 fi;
 ifs-f90nml -i -g namalb ${valb} ${namelist_nemo_seaice};
 fi;
 if [[ "${nemo_eos}" != "undef" ]]; then
 v_nameos=();
 if [[ "${nemo_eos}" = "teos10" ]]; then
 v_nameos=(-v "ln_teos10=.true." -v "ln_eos80=.false.");
 else
 if [[ "${nemo_eos}" = "eos80" ]]; then
 v_nameos=(-v "ln_teos10=.false." -v "ln_eos80=.true.");
 fi;
 fi;
 ifs-f90nml -i -g nameos "${v_nameos[@]}" ${namelist_nemo_ocean};
 fi;
 if [[ "${nemo_icebergs}" != "undef" ]]; then
 if [[ ${nemo_grid} = "eORCA12_Z75" ]]; then
 echo "${cmd}: (Warning) Ignoring NEMO iceberg options which are not available for grid ${nemo_grid}" 1>&2;
 else
 if [[ "${nemo_icebergs}" = "climatological" ]]; then
 rnf_file="runoff_1m_nomask_icb_climatology.nc";
 else
 if [[ "${nemo_icebergs}" = "interannual" ]]; then
 rnf_file="runoff_1m_nomask_icb_interannual.nc";
 fi;
 fi;
 v_namrnf=();
 if [[ "${nemo_grid}" = "eORCA1_Z75" ]]; then
 cnf_vname="socoeff";
 else
 cnf_vname="socoefr";
 fi;
 v_namrnf+=("-v sn_cnf=\"${rnf_file}\",0,\"${cnf_vname}\",.false.,.true.,\"yearly\",\"\",\"\",\"\"");
 v_namrnf+=("-v sn_rnf=\"${rnf_file}\",-1,\"sornficb\",.true.,.true.,\"yearly\",\"\",\"\",\"\"");
 v_namrnf+=("-v sn_t_rnf=\"${rnf_file}\",-1,\"icbtemper\",.false.,.true.,\"yearly\",\"\",\"\",\"\"");
 ifs-f90nml -i -g namsbc_rnf "${v_namrnf[@]}" ${namelist_nemo_ocean};
 fi;
 fi;
 if [[ "${si3_flux_dist}" != "undef" ]]; then
 if [[ "${si3_flux_dist}" = "raw" ]]; then
 nn_flxdist="-1";
 else
 if [[ "${si3_flux_dist}" = "si3step" ]]; then
 nn_flxdist=2;
 else
 if [[ "${si3_flux_dist}" = "cplstep" ]]; then
 nn_flxdist=3;
 fi;
 fi;
 fi;
 v_namsbc_ice=("-v nn_flxdist=${nn_flxdist}");
 ifs-f90nml -i -g namsbc "${v_namsbc_ice[@]}" ${namelist_nemo_seaice};
 fi;
 v_namrun_rst=(-v "ln_writerst=${writerst}");
 v_namrun_rst+=(-v "cn_ocerst_outdir=\"${restart_directory}\"");
 v_namrun_rst+=(-v "nn_stock=${nn_stock}");
 v_namrun_rst+=(-v "ln_rcf_read=${lnrcfread}");
 v_namrun_rst+=(-v "ln_rcf_write=${lnrcfwrite}");
 ifs-f90nml -i -g namrun "${v_namrun_rst[@]}" ${namelist_nemo_ocean};
 ifs-f90nml -i -g nampar "-v cn_icerst_outdir=\"${restart_directory}\"" ${namelist_nemo_seaice};
 for f in ${namelist_nemo_ocean} ${namelist_nemo_seaice} namnemocoup.in namnemowamcoup.in;
 do
 if [[ -f $f.orig ]] && [[ -f $f ]]; then
 nml-diff "$f.orig" "$f" || d=$?;
 if [[ $d -gt 1 ]]; then
 echo "${cmd}: (Error) nml-diff failed to compare $f and $f.orig" 1>&2;
 ((errcnt += 1));
 fi;
 fi;
 done;
 apply_custom_namelist_edits "${namelist_nemo_ocean}" "${nemo_ocean_namelist_edit[@]}";
 apply_custom_namelist_edits "${namelist_nemo_seaice}" "${nemo_seaice_namelist_edit[@]}"
}
BASH_FUNC_fesom_setup_namelists%%=() {  if [[ $fesom -ne 1 ]]; then
 return;
 fi;
 fort4=${fort4:?};
 restart_directory=${restart_directory:?};
 for f in "${fesom_namelists[@]}";
 do
 \cat $f > $f.${pid};
 \cat $f > $f.orig;
 \rm -f $f;
 \mv $f.${pid} $f;
 done;
 fesom_ocean_grid="fesom_$(echo "${fesom_grid}" | tr '[:upper:]' '[:lower:]')";
 declare -A fesom_coup_globs=([cdfile_gauss_to_T]="remap_*_mask_to_${fesom_ocean_grid}_mask_T_L1.nc" [cdfile_gauss_to_UV]="remap_*_mask_to_${fesom_ocean_grid}_mask_U_L1.nc" [cdfile_T_to_gauss]="remap_${fesom_ocean_grid}_mask_T_L1_to_*_mask.nc" [cdfile_UV_to_gauss]="remap_${fesom_ocean_grid}_mask_U_L1_to_*_mask.nc");
 v_namfesomcoup=(-v "cdpathdist='./'" -v "lwritedist=.false." -v "lreaddist=.false.");
 for key in cdfile_gauss_to_T cdfile_gauss_to_UV cdfile_T_to_gauss cdfile_UV_to_gauss;
 do
 matches=(remap/${fesom_coup_globs[$key]});
 if [[ ${#matches[@]} -ne 1 || ! -f "${matches[0]}" ]]; then
 echo "${cmd}: (Error) Expected exactly one FESOM remap file for ${key}" "(glob 'remap/${fesom_coup_globs[$key]}'), found ${#matches[@]}" 1>&2;
 ((errcnt += 1));
 continue;
 fi;
 v_namfesomcoup+=(-v "${key}='./remap/$(\basename "${matches[0]}")'");
 done;
 ifs-f90nml -i -g namfesomcoup "${v_namfesomcoup[@]}" namfesomcoup.in;
 ifs-f90nml -i -g paths -v "MeshId='${fesom_grid}'" namelist.config;
 RCFFILE=${restart_directory}/fesom_raw_restart/np$tasks.info;
 if [ ! -f "$RCFFILE" ]; then
 echo "FESOM: This is the first job. Start FESOM from initial date:";
 ifs_initial_date_epoch=${ifs_initial_date_epoch:?};
 ifs_initial_date_fesom_restart=$(date "+%d%b%Y" -d @"${ifs_initial_date_epoch}");
 fesom_initial_data="${INPROOT}/fesom/v21/${fesom_grid}/${YYYYMMDDZZ}";
 [[ -d "${fesom_initial_data}" ]] || fesom_initial_data="${label}";
 \cp ${fesom_initial_data}/fesom.clock.${ifs_initial_date_fesom_restart} fesom.clock;
 echo "$(cat fesom.clock)";
 if [[ ${MM}${DD} == "0101" ]]; then
 fesom_restart_year=$((YYYY - 1));
 else
 fesom_restart_year=${YYYY};
 fi;
 \cp -r ${fesom_initial_data}/fesom.${fesom_restart_year}.ice.restart.in/ok fesom.${fesom_restart_year}.ice.restart;
 \cp -r ${fesom_initial_data}/fesom.${fesom_restart_year}.oce.restart.in/ok fesom.${fesom_restart_year}.oce.restart;
 mkdir -p ${restart_directory}/fesom_raw_restart;
 ln -s ${restart_directory}/fesom_raw_restart fesom_raw_restart;
 else
 echo "FESOM: This is a restarted job. Restart from previous memory dump:";
 ln -s ${restart_directory}/fesom_raw_restart fesom_raw_restart;
 \cp ${restart_directory}/fesom_raw_restart/fesom.clock fesom.clock;
 echo "$(cat fesom.clock)";
 fi;
 fesom_secs_since_start_of_year=$(head -1 fesom.clock | awk '{printf("%d",$1 + ($2-1)*86400);}');
 fesom_year=$(head -1 fesom.clock | awk '{printf("%d0101",$3)}');
 fesom_year_epoch=$(date -d $fesom_year +%s);
 fesom_date_epoch=$(($fesom_year_epoch + $fesom_secs_since_start_of_year));
 echo "fesom date end of previous run:";
 date -d @"$fesom_date_epoch";
 fesom_prerun_restart_epoch=${fesom_date_epoch};
 end_date_epoch=$((ifs_initial_date_epoch + ${FCLEN} * 60 * 60));
 echo "end date of this run:";
 date -d @"$end_date_epoch";
 fesom_runlength_secs=$(($end_date_epoch - $fesom_date_epoch));
 echo "fesom run_length (in seconds):";
 echo $fesom_runlength_secs;
 echo "fesom run_length (in hours):";
 echo $((fesom_runlength_secs / 60 / 60));
 echo "fesom run_length (in days):";
 echo $((fesom_runlength_secs / 60 / 60 / 24));
 if (( fesom_runlength_secs <= 0 )); then
 echo "${cmd}: (Error) FESOM restart point is at or beyond the requested end date:" "restart $(date -u -d @"${fesom_date_epoch}" '+%Y-%m-%d %H:%M')," "end $(date -u -d @"${end_date_epoch}" '+%Y-%m-%d %H:%M');" "nothing to simulate -- check the restart in ${restart_directory} or the run length" 1>&2;
 exit 1;
 fi;
 ifs-f90nml -i -g timestep -v "run_length=$((fesom_runlength_secs / 60 / 60 / 24))" namelist.config;
 ifs-f90nml -i -g timestep -v "run_length_unit='d'" namelist.config;
 v_nammcc=(-v "LNEMOGRIBFLDS=false" -v "LNEMOGRIBMASK=false" -v "LNEMOOCEICEMIX=false");
 ifs-f90nml -i -g NAMMCC "${v_nammcc[@]}" $fort4;
 for f in "${fesom_namelists[@]}";
 do
 [[ "$f" == "namfesomwamcoup.in" ]] && continue;
 if [[ -f $f.orig ]] && [[ -f $f ]]; then
 d=0;
 nml-diff "$f.orig" "$f" || d=$?;
 if [[ $d -gt 1 ]]; then
 echo "${cmd}: (Error) nml-diff failed to compare $f and $f.orig" 1>&2;
 ((errcnt += 1));
 fi;
 fi;
 done;
 fesom_apply_custom_namelist_edits
}
BASH_FUNC_ifs_namelist_assemble_naephy%%=() {  fort4=${fort4:?};
 if [[ "$purge_naephy" == true || "$naephy_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAEPHY $fort4;
 fi;
 if [[ "${naephy_template}" != "undef" ]]; then
 \cat ${naephy_template} >> $fort4;
 fi;
 if (( ${#in_naephy[@]} > 0 )); then
 ifs-f90nml -i -g NAEPHY "${in_naephy[@]}" $fort4;
 fi
}
BASH_FUNC_ifs_namelist_assemble_nammcc%%=() {  fort4=${fort4:?};
 if [[ "$purge_nammcc" == true || "$mcc_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMMCC $fort4;
 fi;
 if [[ "${mcc_template}" != "undef" ]]; then
 \cat ${mcc_template} >> $fort4;
 fi;
 if (( ${#in_mcc[@]} > 0 )); then
 ifs-f90nml -i -g NAMMCC "${in_mcc[@]}" $fort4;
 fi
}
BASH_FUNC_multio_ocean_grib_templates_path%%=() {  echo "${multio_plans_root:?}/climate-dt/grib_templates"
}
BASH_FUNC_ifs_namelist_assemble_namcompo_emis_aux%%=() {  fort4=${fort4:?};
 if [[ "$purge_namcompo_emis_aux" == true || "$compo_emis_aux_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMCOMPO_EMIS_AUX $fort4;
 fi;
 if [[ "${compo_emis_aux_template}" != "undef" ]]; then
 \cat ${compo_emis_aux_template} >> $fort4;
 fi;
 if (( ${#in_compo_emis_aux[@]} > 0 )); then
 ifs-f90nml -i -g NAMCOMPO_EMIS_AUX "${in_compo_emis_aux[@]}" $fort4;
 fi
}
BASH_FUNC_forcings_setup_namelists%%=() {  fort4=${fort4:?};
 ifsdata=${ifsdata:?};
 if [[ $nemo -eq 0 && $fesom -eq 0 ]]; then
 if [[ $mcc -eq 1 ]]; then
 lmccec="true";
 lmcciec="false";
 else
 lmccec="false";
 lmcciec="true";
 fi;
 in_mcc+=(-v "LMCCEC=${lmccec}" -v "LMCCIEC=${lmcciec}" -v "LMCC_COMPO=false" -v "LNEMOCOUP=false");
 fi;
 if [[ "${ghg}" = "undef" ]]; then
 :;
 else
 if [[ "${ghg}" == CMIP6-SSP[0-9][0-9][0-9] ]]; then
 ghg_scenario="${ghg#CMIP6-}";
 [[ "$ghg_file" = "undef" ]] && ghg_file="${ifsdata}/greenhouse_gas_timeseries_CMIP6_${ghg_scenario}_CFC11equiv_47r1.nc";
 if [[ ! -f "${ghg_file}" ]]; then
 echo "${cmd}: (Error) GHG timeseries file ${ghg_file} not found." 1>&2;
 exit 1;
 fi;
 in_naerad+=(-v "CGHGTIMESERIESFILE=\"${ghg_file}\"");
 else
 if [[ "${ghg}" == CMIP7-@(l|ml|m|h) ]]; then
 ghg_scenario="${ghg#CMIP7-}";
 [[ "$ghg_file" = "undef" ]] && ghg_file="${ifsdata}/greenhouse_gas_timeseries_CMIP7_${ghg_scenario}_CFC11equiv_51r1.nc";
 if [[ ! -f "${ghg_file}" ]]; then
 echo "${cmd}: (Error) GHG timeseries file ${ghg_file} not found." 1>&2;
 exit 1;
 fi;
 in_naerad+=(-v "CGHGTIMESERIESFILE=\"${ghg_file}\"");
 else
 echo "${cmd}: (Error) ghg can only be 'undef', 'CMIP6-SSPXXX', or 'CMIP7-{l,ml,m,h}'. We got ghg=${ghg}" 1>&2;
 exit 1;
 fi;
 fi;
 fi;
 if [[ "${ozone}" = "undef" ]]; then
 :;
 else
 if [[ "$ozone" = "none" ]]; then
 in_naephy+=(-v "LEO3CH=false");
 in_naephy+=(-v "LO3CH_HLO=false");
 in_naerad+=(-v "LEPO3RA=false");
 in_naerad+=(-v "NO3CMIP=0");
 fp_gfl+=(-v "YO3_NL%LGP=false");
 else
 if [[ "$ozone" = "hlo" ]]; then
 in_naephy+=(-v "LEO3CH=true");
 in_naephy+=(-v "LO3CH_HLO=true");
 in_naerad+=(-v "LEPO3RA=true");
 in_naerad+=(-v "NO3CMIP=0");
 fp_gfl+=(-v "YO3_NL%LGP=true");
 else
 if [[ "${ozone}" == CMIP6-SSP[0-9][0-9][0-9] ]]; then
 ozone_scenario="${ozone#CMIP6-}";
 [[ "$ozone_dir" = "undef" ]] && ozone_dir="${ifsdata}/cmip6-ozone-scenarios/${ozone_scenario}";
 if [[ ! -d "${ozone_dir}" ]]; then
 echo "${cmd}: (Error) Ozone directory $ozone_dir not found." 1>&2;
 exit 1;
 fi;
 in_naephy+=(-v "LEO3CH=false");
 in_naephy+=(-v "LO3CH_HLO=false");
 in_naerad+=(-v "LEPO3RA=false");
 in_naerad+=(-v "NO3CMIP=6");
 fp_gfl+=(-v "YO3_NL%LGP=false");
 in_naerad+=(-v "CO3DATADIR=\"${ozone_dir}\"");
 else
 echo "${cmd}: (Error) ozone can only be 'none', 'hlo', or 'CMIP6-SSPXXX'. We got ozone=${ozone}" 1>&2;
 exit 1;
 fi;
 fi;
 fi;
 fi;
 if [[ "${volcanic}" = "undef" ]]; then
 :;
 else
 if [[ "$volcanic" = "none" ]]; then
 in_naerad+=(-v "LHVOLCA=false");
 in_naerad+=(-v "NVOLCVERT=0");
 in_naerad+=(-v "LVOLCDATA=false");
 in_naerad+=(-v "NVOLCFORMAT=1");
 else
 if [[ "$volcanic" = @(CMIP6|EVA_H_prescribed) ]]; then
 in_naerad+=(-v "LHVOLCA=true");
 in_naerad+=(-v "LVOLCDATA=true");
 if [[ "$ozone" = "hlo" ]]; then
 in_naerad+=(-v "NVOLCVERT=2");
 else
 in_naerad+=(-v "NVOLCVERT=1");
 fi;
 if [[ "${volcanic}" = "CMIP6" ]]; then
 [[ "${volcanic_file}" = "undef" ]] && volcanic_file="${ifsdata}/cmip6_stratospheric_aerosol_aod_extend.dat";
 in_naerad+=(-v "NVOLCFORMAT=1");
 else
 [[ "${volcanic_file}" = "undef" ]] && volcanic_file="${ifsdata}/EVAH_V1.01_prescribed_L137_pl_1979-2100.nc";
 in_naerad+=(-v "NVOLCFORMAT=2");
 fi;
 if [[ ! -f ${volcanic_file} ]]; then
 echo "${cmd}: (Error) Volcanic forcing file ${volcanic_file} not found." 1>&2;
 exit 1;
 fi;
 in_naerad+=("-v CVOLCDATA=\"${volcanic_file}\"");
 else
 echo "${cmd}: (Error) volcanic scenario volcanic can only be 'none', 'CMIP6', 'EVA_H_prescribed'. We got volcanic=${volcanic}" 1>&2;
 exit 1;
 fi;
 fi;
 fi;
 case "${tropaerosols}" in 
 undef)

 ;;
 49r2-hist)
 [[ "$tropaerosols_file" = "undef" ]] && tropaerosols_file="${ifsdata}/aerosol_cams_climatology_49r2_1951-2019_4D.nc"
 ;;
 49r2-MACv2SP-SSP119 | 49r2-MACv2SP-SSP126 | 49r2-MACv2SP-SSP245 | 49r2-MACv2SP-SSP370)
 ssp="${tropaerosols##*-}";
 ssp="${ssp,,}";
 [[ "$tropaerosols_file" = "undef" ]] && tropaerosols_file="${ifsdata}/aerosol_cams-extended-macv2sp-${ssp}_climatology_49r2_1951-2100_4D.nc"
 ;;
 *)
 echo "${cmd}: (Error) tropaerosols can only be '49r2-hist', or '49r2-MACv2SP-SSPXXX'. We got tropaerosols=${tropaerosols}" 1>&2;
 exit 1
 ;;
 esac;
 if [[ "${tropaerosols_file}" != "undef" ]]; then
 if [[ ! -f ${tropaerosols_file} ]]; then
 echo "${cmd}: (Error) Tropospheric aerosol forcing file ${tropaerosols_file} not found." 1>&2;
 exit 1;
 fi;
 in_naerad+=(-v "CAERCLIMFILE=\"${tropaerosols_file}\"");
 fi;
 if [[ "${fixyear}" != "undef" ]]; then
 in_naerad+=(-v "NCMIPFIXYR=${fixyear}");
 fi
}
BASH_FUNC_apply_custom_namelist_edits%%=() {  local target_namelist=$1;
 shift 1;
 local namelist_edits=("$@");
 local this_namelist_edit section assignment;
 if [[ ${#namelist_edits[@]} -gt 0 ]]; then
 for this_namelist_edit in "${namelist_edits[@]}";
 do
 section=${this_namelist_edit%%/*};
 assignment=${this_namelist_edit#*/};
 ifs-f90nml -i -g "${section}" -v "${assignment}" "${target_namelist}" || { 
 echo "${cmd}: (Error) Failed to apply namelist edit: \"ifs-f90nml -i -g ${section} -v ${assignment} ${target_namelist}\"" 1>&2;
 ((errcnt += 1))
 };
 done;
 fi
}
BASH_FUNC_multio_check_opts%%=() {  cmd=${cmd:?};
 ifs_dir=${ifs_dir:?};
 if [[ "${use_multio_ifs}" != "true" && "${use_multio_ifs}" != "false" ]]; then
 echo "${cmd}: (Error) Invalid value provided to --use-multio-ifs: ${use_multio_ifs}, supported options are \"true\" or \"false\"" 1>&2;
 ((errcnt += 1));
 fi;
 if [[ "${use_multio_ocean}" != "true" && "${use_multio_ocean}" != "false" ]]; then
 echo "${cmd}: (Error) Invalid value provided to --use-multio-ocean: ${use_multio_ocean}, supported options are \"true\" or \"false\"" 1>&2;
 ((errcnt += 1));
 fi;
 if [[ "${use_multio_ifs}" != "true" && "${use_multio_ocean}" != "true" ]]; then
 return;
 fi;
 if [[ $multio_plans_root = "undef" ]]; then
 multio_plans_root="${ifs_dir}/share/multio-plans";
 fi;
 env_exports+=("MULTIO_DEBUG=0")
}
BASH_FUNC_wam_setup_files%%=() {  cmd=${cmd:?};
 inprootnam=${inprootnam:?};
 label=${label:?};
 if [[ "$lwcou" != "true" ]]; then
 return;
 fi;
 if [[ $inprootnam -eq 0 ]]; then
 RAPS_NAMDIR_WAM="${RAPS_ETCDIR}/nam/${RAPS_IFS_CYCLE}/wam";
 [[ -f $RAPS_NAMDIR_WAM/wam_namelist ]] && \cp $RAPS_NAMDIR_WAM/wam_namelist .;
 else
 if [[ -f $label/wam_namelist ]]; then
 \cp $label/wam_namelist .;
 else
 echo "${cmd}: (Error) WAM namelist wam_namelist is missing! Tried directory $label";
 exit 1;
 fi;
 fi;
 for wm in wam_subgrid_0 wam_subgrid_1 wam_subgrid_2 wam_grid_tables specwavein uwavein sfcwindin cdwavein;
 do
 if [[ -f $label/$wm ]]; then
 \ln -s $label/$wm .;
 else
 echo "${cmd}: (Error) WAM namelist $wm is missing! Tried directory $label";
 exit 1;
 fi;
 done
}
BASH_FUNC_ifs_namelist_assemble_namdphy%%=() {  fort4=${fort4:?};
 if [[ "$purge_namdphy" == true || "$dphy_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMDPHY $fort4;
 fi;
 if [[ "${dphy_template}" != "undef" ]]; then
 \cat ${dphy_template} >> $fort4;
 fi;
 if (( ${#in_dphy[@]} > 0 )); then
 ifs-f90nml -i -g NAMDPHY "${in_dphy[@]}" $fort4;
 fi
}
BASH_FUNC_multio_ocean_plan_defaults%%=() {  nemo_grid=${nemo_grid:?};
 orca=$(echo "${nemo_grid}" | cut -f1 -d_);
 multio_ifs_model=${multio_ifs_model:?};
 expver=${expver:?};
 experiment=${experiment:?};
 generation=${generation:?};
 activity=${activity:?};
 realization=${realization:?};
 resolution=${resolution:?};
 multio_plans_root=${multio_plans_root:?};
 nemo_time_step=${nemo_time_step:?};
 resol=${resol:?};
 local_env=();
 local_env+=(-v "NEMO_GRID=${orca}");
 local_env+=(-v "NEMO_INTEGRATION_STEP=${nemo_time_step}");
 local_env+=(-v "MODEL=${multio_ifs_model}");
 local_env+=(-v "EXPVER=${expver}");
 local_env+=(-v "MULTIO_HEALPIX_ENABLED=1");
 local_env+=(-v "MULTIO_ENCODE_CACHED=1");
 local_env+=(-v "EXPERIMENT=${experiment:?}");
 local_env+=(-v "GENERATION=${generation:?}");
 local_env+=(-v "ACTIVITY=${activity:?}");
 local_env+=(-v "REALIZATION=${realization:?}");
 local_env+=(-v "RESOLUTION=${resolution:?}");
 local_env+=(-v "MULTIO_PLANS_PATH=${multio_plans_root:?}/climate-dt");
 local_env+=(-v "NATIVE_PLANS_ENABLED=1");
 local_env+=(-v "ENABLE_SINK_FILE=0");
 local_env+=(-v "ENABLE_SINK_FDB=1");
 local_env+=(-v "MULTIO_HEALPIX_ENABLED=1");
 local_env+=(-v "MULTIO_ENCODE_CACHED=1");
 if [[ $resol == 79 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H32_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=0");
 else
 if [[ $resol == 399 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=0");
 else
 if [[ $resol == 1279 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_GRID=H512_nested");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=1");
 else
 if [[ $resol == 2559 ]]; then
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_GRID=H128_nested");
 local_env+=(-v "MULTIO_HEALPIX_STANDARD_ENABLED=1");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_GRID=H1024_nested");
 local_env+=(-v "MULTIO_HEALPIX_HIGH_ENABLED=1");
 fi;
 fi;
 fi;
 fi;
 echo "${local_env[@]}"
}
BASH_FUNC_ifsphys_setup_namelists%%=() {  cmd=${cmd:?};
 fort4=${fort4:?};
 resol=${resol:?};
 if [[ ${levimoe} -eq 1 ]]; then
 ifs-f90nml -i -g NAEPHY -v "LEVIMOE=true" "$fort4";
 fi;
 v_naerad_phys=();
 [[ "${toa_tuning}" = "destine_phase2" ]] && v_naerad_phys+=(-v "RMINICE=40.0");
 [[ "${toa_tuning}" = "destine_49r3base" ]] && v_naerad_phys+=(-v "RMINICE=50.0");
 [[ ${#v_naerad_phys[@]} -gt 0 ]] && ifs-f90nml -i -g NAERAD "${v_naerad_phys[@]}" $fort4;
 v_cldp=();
 if [[ "${toa_tuning}" = @(destine_phase2|destine_49r3base) ]]; then
 if [[ "${toa_tuning}" = "destine_49r3base" ]]; then
 rcldiff="0.0000035";
 else
 rcldiff="0.000004";
 fi;
 v_cldp=(-v "RCL_INHOMOGACC=2.0" -v "RCLDIFF=${rcldiff}" -v "RXRAINEVAP=0.07");
 fi;
 [[ ${#v_cldp[@]} -gt 0 ]] && ifs-f90nml -i -g NAMCLDP "${v_cldp[@]}" $fort4;
 if [[ $convection = "no-deep" ]]; then
 ifs-f90nml -i -g NAMCUMF -v "LMFPEN=false" $fort4;
 else
 if [[ $convection = "rcbmf" ]]; then
 if [[ ${resol} -lt 1279 ]] || [[ ${resol} -ge 15999 ]]; then
 echo "${cmd}: (Error) RCBMF not scientifically sensible for resolution tco${resol}" 1>&2;
 exit 1;
 fi;
 rdxfac=$(echo "scale=2; 16000 / $(( resol + 1 ))" | bc);
 ifs-f90nml -i -g NAMCUMF -v "RDXFAC=${rdxfac}" $fort4;
 fi;
 fi
}
BASH_FUNC_nemo_check_opts%%=() {  cmd=${cmd:?};
 end_restart=${end_restart:?};
 iomode=${iomode:?};
 lwcou=${lwcou:?};
 no_restart=${no_restart:?};
 trunc=${trunc:?};
 if [[ $nemo -ne 1 ]]; then
 return;
 fi;
 lwcou=true;
 attr="${attr}nemo=1 ";
 orca=$(echo "${nemo_grid}" | cut -f1 -d_);
 if [[ "${orca}" != @(eORCA1|eORCA025|eORCA12) ]]; then
 nemo_time_step=1;
 echo "${cmd}: (Error) Unsupported NEMO horizontal resolution ${orca}" 1>&2;
 ((errcnt += 1));
 fi;
 if [[ "${nemo_time_step}" = "undef" ]]; then
 [[ "${orca}" = "eORCA1" ]] && nemo_time_step=3600;
 [[ "${orca}" = "eORCA025" ]] && nemo_time_step=1200;
 [[ "${orca}" = "eORCA12" ]] && nemo_time_step=360;
 fi;
 nemo_vertical_axis=$(echo "${nemo_grid}" | cut -f2 -d_);
 if [[ "${nemo_vertical_axis}" != "Z75" ]]; then
 echo "${cmd}: (Error) Unsupported NEMO vertical axis ${nemo_vertical_axis}" 1>&2;
 ((errcnt += 1));
 fi;
 nemo_ice_albedos_supported_options=(undef 48r1 48r2 era6);
 if [[ ! " ${nemo_ice_albedos_supported_options[*]} " =~ [[:space:]]${nemo_ice_albedos}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --nemo-ice-albedos: ${nemo_ice_albedos}, supported options are: ${nemo_ice_albedos_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 nemo_eos_supported_options=(undef teos10 eos80);
 if [[ ! " ${nemo_eos_supported_options[*]} " =~ [[:space:]]${nemo_eos}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --nemo-eos: ${nemo_eos}, supported options are: ${nemo_eos_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 nemo_icebergs_supported_options=(undef climatological interannual);
 if [[ ! " ${nemo_icebergs_supported_options[*]} " =~ [[:space:]]${nemo_icebergs}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --nemo-icebergs: ${nemo_icebergs}, supported options are: ${nemo_icebergs_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 si3_flux_dist_supported_options=(undef raw si3step cplstep);
 if [[ ! " ${si3_flux_dist_supported_options[*]} " =~ [[:space:]]${si3_flux_dist}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --si3-flux-dist: ${si3_flux_dist}, supported options are: ${si3_flux_dist_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 nemo_full_grid="${orca}_GO8_${nemo_vertical_axis}";
 nn_itend=$((FCLEN*(3600/nemo_time_step)));
 nn_stock=-1;
 if [[ ( ${no_restart} -eq 0 ) && ( ${end_restart} -eq 1 || "$iomode" = @(od|rst) ) ]]; then
 writerst=.true.;
 lnrcfread=.true.;
 lnrcfwrite=.true.;
 if [[ ${end_restart} -eq 1 ]]; then
 nn_stock=${nn_itend};
 else
 nn_stock=$(( $(( 3600 * 48 )) / ${nemo_time_step} ));
 fi;
 else
 writerst=.false.;
 lnrcfread=.false.;
 lnrcfwrite=.false.;
 fi
}
BASH_FUNC_fullpos_parse_opts%%=() {  case "$1" in 
 --purge-namfpc)
 purge_namfpc=true;
 shiftby=1
 ;;
 --namfpc-template)
 fpc_template="$2";
 purge_namfpc=true;
 shiftby=2
 ;;
 --purge-namddh)
 purge_namddh=true;
 shiftby=1
 ;;
 --namddh-template)
 ddh_template="$2";
 purge_namddh=true;
 shiftby=2
 ;;
 --purge-namct0)
 purge_namct0=true;
 shiftby=1
 ;;
 --namct0-template)
 ct0_template="$2";
 purge_namct0=true;
 shiftby=2
 ;;
 --purge-namgrb)
 purge_namgrb=true;
 shiftby=1
 ;;
 --namgrb-template)
 grb_template="$2";
 purge_namgrb=true;
 shiftby=2
 ;;
 --purge-namafn)
 purge_namafn=true;
 shiftby=1
 ;;
 --namafn-template)
 afn_template="$2";
 purge_namafn=true;
 shiftby=2
 ;;
 --purge-namppc)
 purge_namppc=true;
 shiftby=1
 ;;
 --namppc-template)
 ppc_template="$2";
 purge_namppc=true;
 shiftby=2
 ;;
 --purge-namgfl)
 purge_namgfl=true;
 shiftby=1
 ;;
 --namgfl-template)
 gfl_template="$2";
 purge_namgfl=true;
 shiftby=2
 ;;
 --surface-fields)
 mfpphy=("$2");
 shiftby=2
 ;;
 --pl-fields)
 mfp3dfp=("$2");
 shiftby=2
 ;;
 --pressure-levels)
 rfp3p=("$2");
 shiftby=2
 ;;
 --norms-frequency)
 norms_frequency="$2";
 shiftby=2
 ;;
 --ddh-frequency)
 ddh_frequency="$2";
 shiftby=2
 ;;
 esac
}
BASH_FUNC_fullpos_assemble_namddh%%=() {  fort4=${fort4:?};
 if [[ "$purge_namddh" == true || "$ddh_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMDDH $fort4;
 fi;
 if [[ "${ddh_template}" != "undef" ]]; then
 \cat ${ddh_template} >> $fort4;
 fi;
 if (( ${#fp_ddh[@]} > 0 )); then
 ifs-f90nml -i -g NAMDDH "${fp_ddh[@]}" $fort4;
 fi
}
BASH_FUNC_parse_etc_model%%=() {  defaults_parse_opts "$@";
 ocean_parse_opts "$@";
 wam_parse_opts "$@";
 forcings_parse_opts "$@";
 restart_parse_opts "$@";
 gpu_parse_opts "$@";
 fullpos_parse_opts "$@";
 ifs_namelist_parse_opts "$@";
 multio_parse_opts "$@";
 ifsphys_parse_opts "$@"
}
BASH_FUNC_ocean_setup_files%%=() {  cmd=${cmd:?};
 inprootnam=${inprootnam:?};
 if [[ $nemo -ne 1 && $fesom -ne 1 ]]; then
 return;
 fi;
 if [[ $inprootnam -eq 0 ]]; then
 RAPS_NAMDIR_COUP="${RAPS_ETCDIR}/nam/${RAPS_IFS_CYCLE}/coup";
 for coup_namelist in namnemocoup.in namnemowamcoup.in;
 do
 [[ -L "${coup_namelist}" ]] && unlink "${coup_namelist}";
 if [[ ! -f "${RAPS_NAMDIR_COUP}/${coup_namelist}" ]]; then
 echo "${cmd}: (Error) Unable to locate coupling namelist ${coup_namelist} in ${RAPS_NAMDIR_COUP}" 1>&2;
 ((errcnt += 1));
 fi;
 \cp -f ${RAPS_NAMDIR_COUP}/${coup_namelist} .;
 done;
 fi;
 nemo_setup_files;
 fesom_setup_files;
 if [[ $inprootnam -eq 1 ]]; then
 for coup_namelist in namnemocoup.in namnemowamcoup.in;
 do
 if [[ -f remap/${coup_namelist} ]]; then
 \cp -f remap/${coup_namelist} .;
 else
 if [[ ! -f ${coup_namelist} ]]; then
 echo "${cmd}: (Error) Coupling namelist ${coup_namelist} is missing!";
 ((errcnt += 1));
 fi;
 fi;
 done;
 fi
}
BASH_FUNC_fesom_postprocess_restart%%=() {  restart_directory=${restart_directory:?};
 if [[ $fesom -ne 1 ]]; then
 return 0;
 fi;
 local raw_restart_dir="${restart_directory}/fesom_raw_restart";
 if [[ -f fesom.clock && -d "${raw_restart_dir}" ]]; then
 \cp fesom.clock "${raw_restart_dir}/.";
 fi;
 if [[ -f namelist.config ]] && grep -Eiq "^[[:space:]]*raw_restart_length_unit[[:space:]]*=[[:space:]]*['\"]?off" namelist.config; then
 return 0;
 fi;
 if [[ ! -f fesom.clock ]]; then
 echo "${cmd}: (Error) FESOM run produced no fesom.clock" 1>&2;
 return 1;
 fi;
 local info_file="${raw_restart_dir}/np${tasks}.info";
 if [[ ! -f "${info_file}" ]]; then
 echo "${cmd}: (Error) missing FESOM raw restart metadata ${info_file}" 1>&2;
 return 1;
 fi;
 local clk1_secs clk1_day clk1_year info_ctime;
 read -r clk1_secs clk1_day clk1_year < fesom.clock;
 { 
 read -r _;
 read -r info_ctime
 } < "${info_file}";
 clk1_secs=${clk1_secs%.*};
 info_ctime=${info_ctime%.*};
 local clk1_ctime=$(( clk1_secs + (clk1_day - 1) * 86400 ));
 if (( info_ctime != clk1_ctime )); then
 echo "${cmd}: (Error) FESOM raw restart ctime (${info_ctime}s) does not match the" "restart point in fesom.clock (${clk1_ctime}s); the restart in ${raw_restart_dir}" "looks outdated or was not written by this run" 1>&2;
 return 1;
 fi;
 if [[ -n "${fesom_prerun_restart_epoch:-}" ]]; then
 local year_epoch restart_epoch;
 year_epoch=$(date -d "${clk1_year}-01-01 UTC" +%s);
 restart_epoch=$(( year_epoch + clk1_secs + (clk1_day - 1) * 86400 ));
 if (( restart_epoch <= fesom_prerun_restart_epoch )); then
 echo "${cmd}: (Error) FESOM restart point did not advance:" "now $(date -u -d @"${restart_epoch}" '+%Y-%m-%d %H:%M')," "run started from $(date -u -d @"${fesom_prerun_restart_epoch}" '+%Y-%m-%d %H:%M');" "the run produced no new restart in ${raw_restart_dir}" 1>&2;
 return 1;
 fi;
 fi;
 return 0
}
BASH_FUNC_restart_setup_namelists%%=() {  bench=${bench:?};
 fort4=${fort4:?};
 iomode=${iomode:?};
 v_namres=();
 v_namios=();
 if [[ ${no_restart} -eq 1 ]]; then
 v_namres+=(-v "NRESTS=-1,-32767");
 else
 v_namios+=(-v "CFRCF='${restart_directory}/rcf'" -v "CIOSPRF='${restart_directory}/srf'");
 if [[ "$iomode" = "od" && "$bench" = ens && $FCLEN -le 360 ]]; then
 v_namios+=(-v "LRCFTIME=true");
 fi;
 if [[ ${end_restart} -eq 1 ]]; then
 v_namres+=(-v "NRESTS=-1,-${FCLEN}" -v "NFRRES=1");
 else
 if [[ "$iomode" = "rst" ]]; then
 if [[ "$bench" = @(hres|oops|clim) ]]; then
 v_namres+=(-v "NRESTS=-5,-48,-96,-144,-192,-240");
 else
 if [[ "$bench" = ens ]]; then
 v_namres+=(-v "NRESTS=-8,-48,-96,-144,-192,-240,-288,-336,-360");
 fi;
 fi;
 else
 if [[ "$iomode" = "od" ]]; then
 if [[ "$bench" = @(hres|oops|clim) ]]; then
 v_namres+=(-v "NRESTS=-5,-48,-96,-144,-192,-240");
 else
 if [[ "$bench" = ens ]]; then
 if [[ $FCLEN -gt 360 ]]; then
 v_namres+=(-v "NRESTS=-1,-9999");
 else
 v_namres+=(-v "NRESTS=-8,-48,-96,-144,-192,-240,-288,-336,-360");
 fi;
 fi;
 fi;
 fi;
 fi;
 fi;
 fi;
 if [[ ${#v_namres[@]} -gt 0 ]]; then
 ifs-f90nml -i -g NAMRES "${v_namres[@]}" $fort4;
 fi;
 if [[ ${#v_namios[@]} -gt 0 ]]; then
 ifs-f90nml -i -g NAMIOS "${v_namios[@]}" $fort4;
 fi
}
BASH_FUNC_multio_setup_ifs%%=() {  ifs_dir=${ifs_dir:?};
 if [[ $use_multio_ifs != true ]]; then
 return;
 fi;
 if [[ $multio_ifs_plan_template = "undef" ]]; then
 return;
 fi;
 is_function multio_ifs_plan_defaults && mapfile -t _tmp < <(multio_ifs_plan_defaults);
 multio_ifs_plan_defaults+=("${_tmp[@]}");
 if [[ $multio_ifs_plan_processor_args != "undef" ]]; then
 multio_ifs_plan_defaults+=("$multio_ifs_plan_processor_args");
 fi;
 multio_plan_processor -c $rundir/.fdb.setup ${multio_ifs_plan_defaults[@]} --input=${multio_plans_root}/${multio_ifs_plan_template} --destination=$rundir/MultIO/multio-plans/atmosphere;
 multio-ifs-setup -t MODEL-DATA-TO-MULTIO -c $RAPS_ETCDIR/multio/multiom.cfg.yaml --output-directory $rundir --ifs-install-dir $ifs_dir --multio-ifs-plan "$rundir/MultIO/multio-plans/atmosphere/$(basename "${multio_ifs_plan_template}")"
}
BASH_FUNC_module_unload%%=() {  echo "+ module unload $*";
 module unload $*
}
BASH_FUNC_gpu_option_enabled%%=() {  [[ " ${gpu[*]} " =~ [[:space:]]$1[[:space:]] ]] && return 0 || return 1
}
BASH_FUNC_fullpos_assemble_namcnt0%%=() {  fort4=${fort4:?};
 if [[ "$purge_namct0" == true || "$ct0_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMCT0 $fort4;
 fi;
 if [[ "${ct0_template}" != "undef" ]]; then
 \cat ${ct0_template} >> $fort4;
 fi;
 is_function nfrpos && nfrpos=$(nfrpos);
 is_function nfrhis && nfrhis=$(nfrhis);
 output_off="1,999999";
 if [[ "${nfrpos}" = "undef" ]]; then
 fp_ct0+=(-v "NFRPOS=1");
 else
 fp_ct0+=(-v "NFRPOS=${nfrpos}");
 fi;
 if [[ "${nfrhis}" = "undef" ]]; then
 fp_ct0+=(-v "NFRHIS=1");
 else
 fp_ct0+=(-v "NFRHIS=${nfrhis}");
 fi;
 if [[ "${nposts}" = "undef" ]]; then
 fp_ct0+=(-v "NPOSTS=${output_off}");
 else
 fp_ct0+=(-v "NPOSTS=${nposts}");
 fi;
 if [[ "${nhists}" = "undef" ]]; then
 fp_ct0+=(-v "NHISTS=${output_off}");
 else
 fp_ct0+=(-v "NHISTS=${nhists}");
 fi;
 if [[ "${norms_frequency}" != "undef" ]]; then
 fp_ct0+=(-v "NFRGDI=${norms_frequency}" -v "NFRSDI=${norms_frequency}");
 fi;
 if [[ "${ddh_frequency}" != "undef" ]]; then
 fp_ct0+=(-v "NFRDHP=${ddh_frequency}" -v "NFRDHFG=${ddh_frequency}");
 fi;
 if [[ "${nfrgdi}" != "undef" ]]; then
 fp_ct0+=(-v "NFRGDI=${nfrgdi}");
 fi;
 if [[ "${nfrsdi}" != "undef" ]]; then
 fp_ct0+=(-v "NFRSDI=${nfrsdi}");
 fi;
 if [[ "${nfrdhp}" != "undef" ]]; then
 fp_ct0+=(-v "NFRDHP=${nfrdhp}");
 fi;
 if [[ "${nfrdhfg}" != "undef" ]]; then
 fp_ct0+=(-v "NFRDHFG=${nfrdhfg}");
 fi;
 if (( ${#fp_ct0[@]} > 0 )); then
 ifs-f90nml -i -g NAMCT0 "${fp_ct0[@]}" $fort4;
 fi
}
BASH_FUNC_ifsphys_parse_opts%%=() {  case "$1" in 
 --toa-tuning)
 toa_tuning=$2;
 shiftby=2
 ;;
 --convection)
 convection="$2";
 shiftby=2
 ;;
 --levimoe)
 levimoe=1;
 shiftby=1
 ;;
 esac
}
BASH_FUNC_ifs_namelist_assemble_namchem%%=() {  fort4=${fort4:?};
 if [[ "$purge_namchem" == true || "$chem_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMCHEM $fort4;
 fi;
 if [[ "${chem_template}" != "undef" ]]; then
 \cat ${chem_template} >> $fort4;
 fi;
 if (( ${#in_chem[@]} > 0 )); then
 ifs-f90nml -i -g NAMCHEM "${in_namchem[@]}" $fort4;
 fi
}
