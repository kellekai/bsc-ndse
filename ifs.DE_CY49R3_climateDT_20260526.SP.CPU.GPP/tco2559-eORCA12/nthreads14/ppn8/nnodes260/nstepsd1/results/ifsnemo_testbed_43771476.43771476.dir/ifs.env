BASH_FUNC_fullpos_assemble_namgrib%%=() {  fort4=${fort4:?};
 if [[ ${purge_namgrb} == true || "$grb_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMGRIB $fort4;
 fi;
 if [[ ${grb_template} != "undef" ]]; then
 \cat ${grb_template} >> $fort4;
 fi;
 if [[ ${mars_class} != "undef" ]]; then
 fp_grb+=(-v "CFCLASS=${mars_class}");
 fi;
 if [[ ${nml_generatingProcessIdentifier} != "undef" ]]; then
 fp_grb+=(-v "NCYCLE=${nml_generatingProcessIdentifier}");
 fi;
 if [[ ${nml_localgrb} != "undef" ]]; then
 fp_grb+=(-v "NLOCGRB=${nml_localgrb}");
 fi;
 if [[ ${mars_stream} != "undef" ]]; then
 fp_grb+=(-v "NSTREAM=${mars_stream}");
 fi;
 if [[ ${nwinoff} != "undef" ]]; then
 ifs-f90nml -i -g NAMGRIB -v NWINOFF=${nwinoff} $fort4;
 else
 ifs-f90nml -i -g NAMGRIB -v NWINOFF $fort4;
 fi;
 if (( ${#fp_grb[@]} > 0 )); then
 ifs-f90nml -i -g NAMGRIB "${fp_grb[@]}" $fort4;
 fi
}
BASH_FUNC_ifs_namelist_assemble_namdyn%%=() {  fort4=${fort4:?};
 if [[ "$purge_namdyn" == true || "$dyn_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMDYN $fort4;
 fi;
 if [[ "${dyn_template}" != "undef" ]]; then
 \cat ${dyn_template} >> $fort4;
 fi;
 if (( ${#in_dyn[@]} > 0 )); then
 ifs-f90nml -i -g NAMDYN "${in_dyn[@]}" $fort4;
 fi
}
BASH_FUNC_gpu_parse_opts%%=() {  case "$1" in 
 --gpu)
 gpu="$2";
 shiftby=2
 ;;
 esac
}
BASH_FUNC_forcings_setup_files%%=() {  cmd=${cmd:?};
 expver=${expver:?};
 fesom=${fesom:?};
 labelroot=${labelroot:?};
 nemo=${nemo:?};
 if [[ "$icmcl" != "undef" ]]; then
 icmcl_dir=$labelroot/$YYYYMMDDZZ/ifsINIT;
 if [[ ! -d $icmcl_dir ]]; then
 echo "${cmd}: Unable to locate ICMCL file directory $icmcl_dir" 1>&2;
 exit 1;
 fi;
 if [[ -f ICMCL${expver}INIT ]]; then
 \rm -f ICMCL${expver}INIT;
 fi;
 if [[ -f $icmcl_dir/$icmcl ]]; then
 \ln -s $icmcl_dir/$icmcl ICMCL${expver}INIT;
 else
 echo "${cmd}: Unable to locate ICMCL file $icmcl_dir/$icmcl" 1>&2;
 exit 1;
 fi;
 fi;
 if [[ $nemo -eq 0 && $fesom -eq 0 ]]; then
 if [[ -f ICMCL${expver}INIT.0 ]]; then
 \rm -f ICMCL${expver}INIT;
 \ln -s ICMCL${expver}INIT.0 ICMCL${expver}INIT;
 mcc=1;
 else
 mcc=0;
 fi;
 fi;
 if [[ "$icmgg" != "undef" ]]; then
 icmgg_dir=$labelroot/$YYYYMMDDZZ/ifsINIT;
 if [[ ! -d ${icmgg_dir} ]]; then
 echo "${cmd}: Unable to locate ICMGG file directory ${icmgg_dir}" 1>&2;
 exit 1;
 fi;
 if [[ -f ICMGG${expver}INIT ]]; then
 \rm -f ICMGG${expver}INIT;
 fi;
 if [[ -f $icmgg_dir/$icmgg ]]; then
 \ln -s $icmgg_dir/$icmgg ICMGG${expver}INIT;
 else
 echo "${cmd}: Unable to locate ICMGG file $icmgg_dir/$icmgg" 1>&2;
 exit 1;
 fi;
 fi
}
BASH_FUNC_nfrhis%%=() {  utstep=${utstep:?};
 echo $((3600/utstep))
}
_=/usr/bin/printenv
