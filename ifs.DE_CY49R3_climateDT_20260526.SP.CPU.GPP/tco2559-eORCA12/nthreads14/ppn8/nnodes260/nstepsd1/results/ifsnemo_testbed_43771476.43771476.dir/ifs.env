BASH_FUNC_ocean_setup_namelists%%=() {  cmd=${cmd:?};
 fort4=${fort4:?};
 if [[ $nemo -ne 1 && $fesom -ne 1 ]]; then
 v_nammcc=(-v LMCC04 -v LMCCDYNSEAICE -v LMCCICEIC -v LNEMO1WAY -v LNEMOFLUXNC -v LNEMOGRIBFLDS -v LNEMOGRIBMASK -v LNEMOLIMALB -v LNEMOLIMTEMP -v LNEMOLIMTHK -v LNEMOLIMTLVL -v LNEMOOCEICEMIX -v LNEMOPARTCOUP -v LNEMOPARTMASK -v LNEMOQNSICEFILT -v LNEMOSICOUP);
 ifs-f90nml -i -g NAMMCC "${v_nammcc[@]}" ${fort4};
 v_naephy=(-v "LECURR=false" -v "LEOCWA=true" -v "LEOBC=false" -v "LEOBCICE=false");
 ifs-f90nml -i -g NAEPHY "${v_naephy[@]}" ${fort4};
 return;
 fi;
 if [[ $fesom -eq 1 || $nemo -eq 1 ]]; then
 v_naephy=(-v "LEOBCICE=false");
 v_naephy+=(-v "LEOBC=${oceanpart}");
 if [[ "$ice_cpl_type" == "thermodynamical" ]]; then
 v_naephy+=(-v "LESICE=false");
 else
 v_naephy+=(-v "LESICE=true");
 fi;
 ifs-f90nml -i -g NAEPHY "${v_naephy[@]}" ${fort4};
 v_nammcc=(-v "LMCCEC=true" -v "LMCCIEC=true" -v "LNEMOCOUP=true" -v "LMCC04=true" -v "LMCCDYNSEAICE=true" -v "LNEMOQNSICEFILT=true" -v "LNEMOPARTCOUP=${oceanpart}" -v "LNEMOLIMALB=${ice_cpl_albedo}");
 if [[ "$ice_cpl_type" == "thermodynamical" ]]; then
 v_nammcc+=(-v "LNEMOLIMTEMP=true");
 v_nammcc+=(-v "LNEMOSICOUP=true");
 v_nammcc+=(-v "LNEMOICETHK=false");
 else
 if [[ "$ice_cpl_type" == "thickness" ]]; then
 v_nammcc+=(-v "LNEMOLIMTEMP=false");
 v_nammcc+=(-v "LNEMOSICOUP=false");
 v_nammcc+=(-v "LNEMOICETHK=true");
 else
 if [[ "$ice_cpl_type" == "fractional" ]]; then
 v_nammcc+=(-v "LNEMOLIMTEMP=false");
 v_nammcc+=(-v "LNEMOSICOUP=false");
 v_nammcc+=(-v "LNEMOICETHK=false");
 fi;
 fi;
 fi;
 if [[ ${nemo} -eq 1 ]]; then
 v_nammcc+=(-v "LNEMOSI3=true" -v "LNEMOOCEICEMIX=true");
 else
 v_nammcc+=(-v "LNEMOSI3=false" -v "LNEMOOCEICEMIX=false");
 fi;
 ifs-f90nml -i -g NAMMCC "${v_nammcc[@]}" ${fort4};
 else
 if [[ "${ice_cpl_albedo}" == "true" ]]; then
 echo "${cmd}: (Error) Sea-ice albedo coupling has been asked, but this requires using either FESOM or NEMO4." 1>&2;
 ((errcnt += 1));
 fi;
 if [[ "$ice_cpl_type" != "undef" ]]; then
 echo "${cmd}: (Error) --ice-cpl-type=${ice_cpl_type} has been explicitly set, but this requires using either FESOM or NEMO4." 1>&2;
 ((errcnt += 1));
 fi;
 fi;
 nemo_setup_namelists;
 fesom_setup_namelists
}
BASH_FUNC_ifs_namelist_assemble_namsatsim%%=() {  fort4=${fort4:?};
 if [[ "$purge_namsatsim" == true || "$satsim_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMSATSIM $fort4;
 fi;
 if [[ "${satsim_template}" != "undef" ]]; then
 \cat ${satsim_template} >> $fort4;
 fi;
 if (( ${#in_satsim[@]} > 0 )); then
 ifs-f90nml -i -g NAMSATSIM "${in_satsim[@]}" $fort4;
 fi
}
BASH_FUNC_restart_check_opts%%=() {  cmd=${cmd:?};
 errcnt=${errcnt:?};
 if [[ ${no_restart} -eq 1 && ${end_restart} -eq 1 ]]; then
 echo "${cmd}: (Error) Running with both --no-restart and --end-restart: these two options are mutually exclusive." 1>&2;
 ((errcnt += 1));
 fi
}
BASH_FUNC_wam_assemble_namelists_io%%=() {  nml_localgrb=${nml_localgrb:?};
 mars_class=${mars_class:?};
 if [[ "$lwcou" == true ]]; then
 f=wam_namelist;
 if [[ -f $f ]]; then
 wam_naline=();
 [[ ${nml_localgrb} != "undef" ]] && wam_naline+=(-v "NLOCGRB=${nml_localgrb}");
 [[ ${mars_class} != "undef" ]] && wam_naline+=(-v "YCLASS=${mars_class}");
 if ((${#wam_naline[@]} > 0 )); then
 ifs-f90nml -i -g NALINE "${wam_naline[@]}" $f;
 fi;
 fi;
 fi
}
BASH_FUNC_ifs_namelist_assemble_namspsdt%%=() {  fort4=${fort4:?};
 if [[ "$purge_namspsdt" == true || "$spsdt_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMSPSDT $fort4;
 fi;
 if [[ "${spsdt_template}" != "undef" ]]; then
 \cat ${spsdt_template} >> $fort4;
 fi;
 if (( ${#in_spsdt[@]} > 0 )); then
 ifs-f90nml -i -g NAMSPSDT "${in_spsdt[@]}" $fort4;
 fi
}
BASH_FUNC_module_load%%=() {  echo "+ module load $*";
 module load $*
}
BASH_FUNC_restart_setup_files%%=() {  cmddir=${cmddir:?};
 if [[ ${no_restart} -eq 1 ]]; then
 return;
 fi;
 mkdir -p ${restart_directory};
 if [[ -x $(which lfs 2>/dev/null) ]]; then
 [[ "${stripestr:-}" = "" ]] || lfs setstripe $stripestr ${stripepool:-} $restart_directory || :;
 lfs getstripe ${stripepool:-} -d $restart_directory || :;
 $cmddir/OST_info . $restart_directory || :;
 fi;
 if [[ "${ndhfdts:-0}" != "0" ]]; then
 \cat /dev/null > $restart_directory/DHFDL$EXPVER;
 ln -s $restart_directory/DHFDL$EXPVER .;
 fi;
 rstsize=$(find $restart_directory -type f -print0 | xargs -0 -r ls -l | awk 'BEGIN {s=0} {s += $(NF-4)} END {print s}');
 echo "IFS CHECKPOINT/RESTART file sizes : $rstsize bytes in $restart_directory";
 ls -ltrR $restart_directory || :
}
BASH_FUNC_wam_check_opts%%=() {  if [[ "$lwcou" = true ]]; then
 attr="${attr}wam=1 ";
 else
 attr="${attr}wam=0 ";
 fi
}
BASH_FUNC_ifsphys_check_opts%%=() {  cmd=${cmd:?};
 toa_tuning=${toa_tuning:?};
 convection=${convection:?};
 toa_tuning_supported_options=(undef destine_phase2 destine_49r3base);
 if [[ ! " ${toa_tuning_supported_options[*]} " =~ [[:space:]]${toa_tuning}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --toa-tuning: ${toa_tuning}, supported options are: ${toa_tuning_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi;
 convection_supported_options=(full no-deep rcbmf);
 if [[ ! " ${convection_supported_options[*]} " =~ [[:space:]]${convection}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --convection: ${convection}, supported options are: ${convection_supported_options[*]}" 1>&2;
 ((errcnt += 1));
 fi
}
BASH_FUNC_fullpos_assemble_namfpc%%=() {  fort4=${fort4:?};
 if [[ "$purge_namfpc" == true || "$fpc_template" != "undef" ]]; then
 ifs-f90nml -i --delete NAMFPC $fort4;
 fi;
 if [[ "${fpc_template}" != "undef" ]]; then
 \cat ${fpc_template} >> $fort4;
 fi;
 if (( ${#mfp3dfp[@]} > 0 )); then
 ( IFS=,;
 fp_fpc+=(-v "MFP3DFP=${mfp3dfp[*]}") );
 fp_fpc+=(-v "NFP3DFP=$(fullpos_count_fields "${mfp3dfp[@]}")");
 fi;
 if (( ${#mfpphy[@]} > 0 )); then
 ( IFS=,;
 fp_fpc+=(-v "NFPPHY=${mfpphy[*]}") );
 fp_fpc+=(-v "NFPPHY=$(fullpos_count_fields "${mfpphy[@]}")");
 fi;
 if (( ${#rfp3p[@]} > 0 )); then
 ( IFS=,;
 fp_fpc+=(-v "RFP3P=${rfp3p[*]}") );
 fi;
 if (( ${#fp_fpc[@]} > 0 )); then
 ifs-f90nml -i -g NAMFPC "${fp_fpc[@]}" $fort4;
 fi
}
BASH_FUNC_gpu_check_opts%%=() {  cmd=${cmd:?};
 gpu_supported_options=(dycore ecphys ecrad pinned mem_pool model_gpu_persist sl1_field_stack);
 if [[ ! "$(declare -p gpu)" =~ "declare -a" ]]; then
 IFS=, read -ra gpu <<< "$gpu";
 fi;
 for gpu_option in "${gpu[@]}";
 do
 if [[ ! " ${gpu_supported_options[*]} " =~ [[:space:]]${gpu_option}[[:space:]] ]]; then
 echo "${cmd}: (Error) Unsupported option provided to --gpu: $gpu_option";
 ((errcnt += 1));
 fi;
 done
}
