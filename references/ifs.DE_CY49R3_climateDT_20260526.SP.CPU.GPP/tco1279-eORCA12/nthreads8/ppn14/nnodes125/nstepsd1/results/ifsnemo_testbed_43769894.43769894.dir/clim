{
    set -x
    \cat ifs.$estim
    \cat ifs.csv
    \cat ifs.table
    \cat ifs.summary
    pwd
    ls -ltrR
    du -sh .
    [[ "${SHOWUSAGE:-}" = "" ]] || $SHOWUSAGE || :
} 2>&1 | tee -a ifs.log

if [[ $rc -eq 0 ]] ; then
    if [[ "$lrefgen" = true ]] ; then
	set +eu # stop failures (not all files below always exist)
	# Gather reference output(s) into one place -- using the final directory structure
	if [[ "$iomode" = @(od|rd|rst) ]] ; then
	    refgen_output_root=io.$refdir
	    refgen_output=$refgen_output_root/$iomode
	    if [[ $nproc_io_nodes -gt 0 ]] ; then
		refgen_output=$refgen_output/io-server/${nproc_io_nodes}_io-nodes
	    else
		refgen_output=$refgen_output/no_io-server
	    fi
	else
	    refgen_output_root=$refdir
	    refgen_output=$refgen_output_root
	fi
	reftag=$trl.$expver.$compiler # we keep $compiler here to emphasize where all came from
	refgen_output=$pid/$refgen_output/$reftag/$hfclen # per FC hours
	mkdir -p $refgen_output
	set +x
	if [[ -f $cmd ]] ; then
	    also="${also}$cmd "
	else
	    also=""
	fi
	if [[ $nemo -eq 1 ]] ; then
	    also="${also}layout.dat solver.stat time.step timing.output ocean.output "
	fi

	# Keep the big ones (drhook.tgz & ECPROF.tgz), too, for reference tarball -- not going to GIT anymore (but ftp.ecmwf.int)
    for f in ifs.* fort.4* NODE.* *nam* ref_*_* $DR_HOOK_PROFILE_DIR/drhook.txt $DR_HOOK_PROFILE_DIR/iodrhook.txt \
           fio.csv fio.txt compinfo.txt meminfo.txt papi_*.txt bwinfo.txt $also
    do
	    [[ -f "$f" ]] && cp -v $f $refgen_output/ &
	done
	set -x
	wait
	\rm -f $refgen_output/*.orig &
	wait
	tgz="${reftag}.tgz"
	cd $pid
	if [[ -x $pigz ]] ; then # multithreaded gzipped tar creation
	    tar -I $pigz -cvf ../$tgz $refgen_output_root
	else
	    tar -zcvf ../$tgz $refgen_output_root
	fi
	cd ..
	\rm -rf $pid &
	echo "*** Reference output tarball in the file $(pwd)/$tgz"
	pwd
	ls -l $tgz
	wait
    fi
fi

set -x
exit $rc
