      /^[[:space:]]*sn_cfctl%l_runstat[[:space:]]*=/d;
      /^[[:space:]]*ln_timing_detail[[:space:]]*=/d
    ' namelist_cfg
    sed -i -E '
      s/ln_timing[[:space:]]*=.*$/&\nln_timing_detail=.true.\nsn_cfctl%l_runstat=.true./
    ' namelist_cfg
    grep -q 'ln_timing_detail=.true.' namelist_cfg || { echo "${cmd}: (Error) namelist_cfg doesn't contain the timing detail setting" >&2; exit 1; }
    grep -q 'sn_cfctl%l_runstat=.true.' namelist_cfg || { echo "${cmd}: (Error) namelist_cfg doesn't contain the runstat setting" >&2; exit 1; }
fi
