if [[ "$lrefout" = true ]] ; then
    ls -ltr res_*_* $ref_input_path/ref_*_*
    \cat res_*_*
    if ! grep -q "calculations are correct" res_*_*; then
      echo "Validation of reference failed! Setting exit code to 1"
