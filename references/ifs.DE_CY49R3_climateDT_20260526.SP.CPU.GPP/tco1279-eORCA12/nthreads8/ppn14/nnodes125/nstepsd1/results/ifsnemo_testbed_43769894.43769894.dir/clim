if [[ $fesom -eq 1 && $rc -eq 0 ]] ; then
    fesom_postprocess_restart || rc=$?
fi

if [[ $rc -ne 0 ]] ; then
    for core in core core.*
    do
	if [[ -f $core ]] ; then
	    (set -x; $gdb -batch -n -q -ex "thread apply all bt" $exe $core 2>/dev/null | perl -pe 's/\(.*\)\s+at\s+/() at /') >> ifs.err
	    [[ $keepcore -eq 0 ]] && \rm -f $core
	fi
    done
fi

bailout=""
if [[ $rc -ne 0 ]] ; then
    if [[ -s ifs.stat ]] ; then
        # Some error(s) happen after all the realistic computation has finished, i.e. CNT0 has appeared in ifs.stat
        cnt0=$(tail -n1 ifs.stat | awk '{print $3}')
        if [[ "$cnt0" = "CNT0" ]] ; then
            bailout=" (ifsMASTER reached CNT0)"
        fi
    fi

    # try to generate useful traceback in ifs.trbk
    $cmddir/ec_addr2line ifs.err | tee ifs.trbk # try first with ec_addr2line (more compact)
    [[ -s ifs.trbk ]] || $cmddir/trbk2line ifs.err | tee ifs.trbk # if empty, use tool useful with ecProf
    [[ -s ifs.trbk ]] || $cmddir/ec_drhook ifs.err | tee ifs.trbk # if empty, fetch EC_DRHOOK lines and a bit more
    [[ -s ifs.trbk ]] || \rm -f ifs.trbk # remove if empty file
fi

if [[ $rc -eq 0 ]] ; then
  if [[ -s "$DR_HOOK_PROFILE_DIR/drhook.1" ]] ; then
        pushd "$DR_HOOK_PROFILE_DIR"
	    if [[ $nproc_io -gt 0 ]] ; then
            comp_tasks=$(seq -s ' drhook.' 1 "$tasks")
            io_tasks=$(seq -s ' drhook.' $((tasks+1)) "$nproc")
            $cmddir/drhook_merge_walltime.pl drhook.$comp_tasks > drhook.txt &
            $cmddir/drhook_merge_walltime.pl drhook.$io_tasks > iodrhook.txt &
         else
	        $cmddir/drhook_merge_walltime.pl drhook.[0-9]* > drhook.txt & # Computational tasks
	    fi
        popd
    fi
fi

# Filter down ifs.err
perl -pe 's/^\s*\[\d+\]\s+//' < ifs.err | $uniqcmd > ifs.err.$pid &

if [[ $ppout -gt 0 ]] || [[ "$iomode" = @(od|rd) ]] ; then
    # Filter down ifs.out
    # Display $fdbdir aka fdb5
    if [[ -d $fdbdir ]] ; then
	if [[ "$lfdbop" = true ]] ; then
	    ls -ld $fdbdir
	    fdbsize=$(du -bs $fdbdir | cut -f1)
	    echo "FDB size : $fdbsize bytes for $fdbdir"
	    ls -ltrR $fdbdir || :
	fi
	[[ $keepfdb -eq 0 ]] && \rm -rf $fdbdir &
    fi
    if [[ "$lfdbop" = false ]] ; then
	fdbsize=$(du -bs ICM*+* | awk '{s+=$1} END {printf("%d\n",s)}')
	echo "ICM size : $fdbsize bytes for files "'ICM*+*'
	ls -ltr ICM*+* || :
	[[ $keepfdb -eq 0 ]] && \rm -rf ICM*+* # ICM-files are only kept if --keepfdb is supplied
    fi
else
    perl -pe 's/^\s*\[\d+\]\s+//' < ifs.out | $uniqcmd > ifs.out.$pid &
fi

echo " " >> ifs.out.$pid # output may not have ended up with a newline
\mv -f ifs.out.$pid ifs.out
\mv -f ifs.err.$pid ifs.err

##-- HACK: to turn on the detailed timing on NEMO side:
if [ -f namelist_cfg ]; then
