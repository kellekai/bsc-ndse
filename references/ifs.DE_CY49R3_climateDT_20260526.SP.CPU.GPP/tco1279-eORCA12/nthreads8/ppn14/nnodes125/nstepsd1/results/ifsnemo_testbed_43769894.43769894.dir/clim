hostname
\cat ifs.hw
id
\cat ifs.out
[[ -f "$DR_HOOK_PROFILE_DIR/drhook.txt" ]] && head -n30 "$DR_HOOK_PROFILE_DIR/drhook.txt"
if [[ $nproc_io -gt 0 ]] ; then
  [[ -f "$DR_HOOK_PROFILE_DIR"/iodrhook.txt ]] && head -n30 "$DR_HOOK_PROFILE_DIR/iodrhook.txt"
  if [[ $keepxml -eq 0 ]] ; then
    \rm -rf io_serv.*.d io_serv.*.xml IOSERV.* &
  fi
