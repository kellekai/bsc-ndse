#!/bin/bash
#
# Batch system independent script to run IFS model under RAPS20
#
# Author: Sami Saarinen (ECMWF) 24-Jan-2017 : Initial version
#                               06-Mar-2017 : RAPS15 pre-production
#                               31-Mar-2017 : Deadline met & RAPS15 ready and placed into the ftp-site ecbench@ftp.ecmwf.int
#                               03-Apr-2017 : Start RAPS16 preparation and single precision validity checking
#                               16-Apr-2017 : Added I/O capability through FDB5
#                               08-Jun-2017 : Released RAPS16 and placed it into the ftp-site ecbench@ftp.ecmwf.int
#                               21-Jun-2017 : Preparations towards RAPS17 -- still under the RAPS16-tag (different GIT-branch)
#                               08-Nov-2017 : Bringing model -script more up to date for the actual RAPS17
#                               09-Feb-2018 : Operational & research I/O activated via --od & --rd (EMOS-lib needed for --od)
#                               23-Apr-2018 : RAPS18 starting to take a shape (GIT branch mps_CY45R1_raps18dev)
#                               17-May-2018 : Ability to run non-hydrostatic dynamics jobs, too (even with lower resolution) : use --nhdyn
#                               30-Aug-2018 : Final pushes for the ITT 270
#                               09-Oct-2019 : Start RAPS19 (works with the same input as RAPS18 since CY45R1)
#
#         Ioan Hadade, (ECMWF), 03-Feb-2021 : Begin RAPS20 based on CY47R3
#                               07-Dec-2023 : Major clean-up
#                               12-Feb-2024 : RAPS21 based on CY49R1
#                               24-Oct-2025 : Big clean-up
#

set +x
set -eua

shopt -s extglob # enables extglob i.e. @(x|y|z) regular expressions in bash

bashsrc=$(basename "${BASH_SOURCE[0]}")

if [[ ${BASH_VERSINFO[0]} -lt 4 ]] ; then
    PS4='+ [${bashsrc}:${LINENO}]: '
else # only v4 onwards supports the below one w/o silent deaths
    _tref=$(date +%s)
    PS4='+ [${bashsrc}:$(($(date +%s)-_tref))s:$(date +%T):${LINENO}]: '
fi

is_function() { declare -F "$@" > /dev/null; }

t1=$(date +%s.%N)
started=$(date -R) # must be with -R or date --date="$started" in jobinfo may occasionally fail

errcnt=0
launcher=${launcher:-""}

cmddir=$(dirname "$(which "$0")")
cmd=$(basename "$0")
cmdargs=${*:-}

pid=$$
attr=""
json=forecast.json
stochastic=0


# Usage: model
lrefgen=false           #                   # Add reference output (usually by us -- prefer 6h forecast)
ref_input_path=${REF_INPUT_PATH:-undef}     # Sets REF_INPUT_PATH to used by ifs/dia/spnorm.F90 (default = $INPROOT/reference_output/$expver)
compiler="undef"        # -C [cray|cce|intel|gnu|pgi|nv] # Specific compiler environment in mind ?
yyyymmddzz="undef"      # -d YYYYMMDDZZ     # Starting date (stamp)
dryrun=0
dycore=0                # --dycore          # activates dynamical core and sets dycore to 1
expver="undef"          # -e experiment_id  # 4 character identification supplied by ECMWF) -- must be given
outexp=""               # --outexp 9000     # output experiment id (default = input expver)
fclen="t1"              # -f [h6|t20|d1]    # forecast length in hours or days (e.g. h6 or d1) or time steps (e.g. t20)
lfdbop=true             # option -F         # Turns OFF use of FDB on (default: may use FDB4|5 or just dummies from ifsiodummy/)
ifs_dir=${RAPS_IFS_BUILDDIR:-"undef"} # ifs-dir  # IFS build or install directory
iodevnull=0             # --io-devnull      # Redirect FDB output to /dev/null (IFS legacy output with multio)
nouttype=2              # =2 if FDB is on (def) or =1 otherwise (pbio)
gstats=false            # -g                # Turns GSTATS output on (detailed & barrier stats)
nopt_memory=2           #                   # GP-model: 0=heap 1=stack 2=improved heap (new default) version
thread_guardsize_mb=0   # -G [0|64]         # Provide guard region (in MB) between slace thread stack (~ Cray)
htway=1                 # -h htway          # How many ways hyperthreaded (htway e.g. 1 or 2 or even 4 on KNL)
host=""                 # -H host       # Preferred host
nproc_io_nodes=0        #                   # Number of I/O nodes (purely for I/O tasks -- no compute tasks)
nproc_io=0              # -I <iotasks>      # Number of I/O server tasks -- now calculated from nproc_io_nodes unless nproc_io > 0
ocean_nproc_ionodes=0
ocean_nproc_io=0        #  # Number of I/O server tasks -- now calculated from nproc_io_nodes unless nproc_io > 0
jobid=${pid}            # -j <jobid>        # Job ID
jobname="jobname"       # -J <jobname>      # Job name
drhook=false            # -k                # Turns DrHook profiling on (DR_HOOK=1 always, but sets DR_HOOK_OPT=prof)
levels=137              # -l <levels>       # Number of atmospheric levels
LABEL=LABEL             # -L [LWDA|ENFO]    # Label to locate (captured) input data
stktrace="undef"
memtrace=0
membind=0               # --membind         # Adopt numactl --membind in ecbind
nodes=0                 # -n <num_nodes>    # Number of nodes we are running (default = 0 --> we *try* to define ourselves)
nproma=16               # -N <nproma>       # Blocking factor for IFS loops (for cache memory efficiency)
nrproma=0               # Note: in the old RAPS, nrproma used to be set to 1 with resolutions finer than 1999 "to save memory". But, nextGEMS/climDT exps would reset it to 0 for all res.
nproma_wam=32
nradfr="undef"          # --nradfr <value>  # Frequency for calling the radiation scheme
nradint="undef"         # --nradint <value> # If supplied, will replace/add nradint=<value> to the namelist NAERAD
leradi=true
noutput=1               # Diagnostic output 0= no diagnostic output, 1= diagnostic output from PE 0, 2= diagnostic output from all PEs
ppout=0                 #                   # Output frequency in hours (by default) or with "<number>t" | "t<number>" to denoting timesteps
ppout_unit=h
tasks=0                 # -p <mpi>          # Total number of MPI-tasks (no defaults)
PATH=".:$(pwd):$PATH"
                        # -P $directory     # Add directory in front of $PATH -- can be supplied multiple time (LIFO-ordering)
perf=""
resol=0                 # -r [21|159|255|399|511|639|1023|1279|1999] # One of the atmospheric resolutions to be used (no defaults)
rundir=""
fdbdir="undef"
lrefout=true            # -R                # Turns reference output check OFF -- by default an attempt to do refer. check is ON
stacksize="undef"       # -s <stacksize_MB> # Slave thread(s) stack size in MB -- the default is resolution dependent
sync_level=0            # -S [0|1|2]        # Sets NTRANS_SYNC_LEVEL for Transposes (nampar1) : default = 0
tag="undef"
threads=1               # -t <omp>          # Number of OpenMP-threads (default = 1)

trunc="tco"             # -T [t|tl|tco]     # Grid type (lowercase) (default = tco)
tstep=0                                     # Change utstep to this if tstep > 0
vmax2="undef"          # --vmax2 <value>   # If supplied, will replace/add VMAX2=<value> to the fort.4 NAMDYN section; maximum wind value, bit ident limiter for performance.
luseflt="undef"         # -u                # Turn explicitly FLT off (add LUSEFLT=false to NAMTRANS)
                        # -U                # Turn explicitly FLT on  (add LUSEFLT=true to NAMTRANS)
exefrom="ifsMASTER.*"   # -x ifsMASTER      # ifsMASTER executable path ("*" is "DP" or "SP" depending on precision used)
wrapper=""              # -w wrapper_script # run ifsMASTER via wrapper-script (which e.g. may raise stacksize to unlimited)
keepfdb=0               #                   # To keep FDB files after the run (eats potentially lots of disk space)
core=1                  # --core/--no-core  # Enable/disable core dumps via DR_HOOK
keepcore=0              #                   # To keep core-files after failure (and gdb processing)
nwrnode=1               #                   # Number of writers per node (when I/O server is not used) (default=1)
                                            # Can be decimal e.g. --writers=0.5 means one writer every 2nd node
                                            # Negative (say -2) --nwriters=-2 means also every 2nd node
nprintlev=0             #                   # 0 = "basic prints" (def); 1 = "more prints"; 2 = "debug prints"
iomode="undef"          # iomode=od if operational I/O in all cases ppout is set to 0

nhdyn=0                 # turn on non-hydrostatic dynamics via --nhdyn or --non-hydrostatic --> nhdyn=1
keepxml=0               # Use --keepxml to avoid deletion of I/O-server related info files, like XML
coxmldir="io_serv.xml.d"
noxml=0                 # Use --noxml to avoid writing XML stats from I/O-server (written to /dev/null though)
places=" --places"      # --places would add --places to any calls where we invoke ecbind -- by default IS set (use --no-places to unset)
NTHREAD_IO=${NTHREAD_IO:-1} # How many actual OMP-threads ever made available for I/O-tasks ; should normally be 1
member=1                # sets MEMBER=$member when $member > 0 and denotes perturbed ENS member# (--member | --pf ) 1..totens
                        # with --cf or control forecast member stays =0 -- as if HRES (w/o stochastic physics)
totens=${SLURM_ARRAY_TASK_MAX:-51}  # Total ensemble size (=50 by default) -- change via --totens <value> ; needed for ENS-runs
stripe=undef            # --stripe [count],size[,poolname] or --stripe count[,size,poolname] instead of "," you can also use ":" or "/", too
delay=undef             # --delay 10,5 would place 10 and 5 sec delays before and after the invocation of the IFS executable
target=undef            # --target=d5 gives prediction towards 5-day FC rather than 10 or 15-day
                        # --target=14 gives prediction towards 14 iterations in TLADJ rather than 27 (TCo) or 35 (T/TL)
iobufs=0                # --iobufs 20 would allocate 20 I/O buffers for *each* I/O-task (default = 10 := NIO_SERV_BUF_MAXSIZE)
physics="yes"           # --physics=no turns LEPHYS=false but also implies no NEMO & no WAM and empty NAMFPC & NAMDDH namelists
                        # Further suboptions to be added
inprootnam=0            # Use namelists from INPROOT (default 0 i.e., use namelists from RAPS etc dir)
firstout=0              # --firstout=<value> : specify first output step for --ppout -kind of requests
khz=0                   # choose clock freq via --freq or --ghz 1.8 (in GHz)
ppnin=0                 # User defined upper limit for processes (MPI-tasks) per node via --ppn <value>
uniq=0                  # With --uniq sets "uniqcmd" to "uniq" ; with  --no-uniq sets "uniqcmd" to "cat" -- this is the default
mptype=${MP_TYPE:-1}               # f.ex. --mptype=2 changes MP_TYPE=1 (MPI_Send) to MP_TYPE=2 (standard MPI_Bsend -- relies on mailbox size)
                                   # please note : when MP_TYPE=1, the mailbox-size will be set to 0
nprtrw=0
nprtrv=0
compo=0
forge_ddt=0              # --forge-ddt (default: no) runs $LAUNCHCMD inside ARM Forge/DDT. Remember to export forge_tmpdir=${TMPDIR} from your sbatch script
forge_map=0              # --forge-map (default: no) runs $LAUNCHCMD inside ARM Forge/DDT. Remember to export forge_tmpdir=${TMPDIR} from your sbatch script

# INPROOT, OUTROOT can be set via CLI, but if not, they will be read from env.
INPROOT=${INPROOT:-"undef"}
OUTROOT=${OUTROOT:-"undef"}

# End usage

lkey="generate-reference-output genref refgen"
lkey="$lkey reference-input-path:"
lkey="$lkey ifs-dir:"
lkey="$lkey compiler:"
lkey="$lkey datestamp: yyyymmddzz:"
lkey="$lkey expver: expid: getenv: iotrace: plain: memdebug: env: outexp: unset:"
lkey="$lkey fclen: forecast:"
lkey="$lkey no-fdb icm io-devnull iodevnull"
lkey="$lkey gstats"
lkey="$lkey gp-model-heap gp-model-stack gp-model-heap2"
lkey="$lkey thread-guardsize:"
lkey="$lkey ht: smt:"
lkey="$lkey host:"
lkey="$lkey launcher:"
lkey="$lkey iotasks: ionodes:"
lkey="$lkey ocean-iotasks: ocean-ionodes:"
lkey="$lkey jobid:"
lkey="$lkey jobname:"
lkey="$lkey drhook"
lkey="$lkey no-drhook"
lkey="$lkey hugepages"
lkey="$lkey levels:"
lkey="$lkey label: input-data-label:"
lkey="$lkey nodes: "
lkey="$lkey nproma: nrproma: nwamproma: old-radiation-scheme no-radiation nradfr:"
lkey="$lkey ppout: output-frequency: firstout:"
lkey="$lkey mpi: tasks:"
lkey="$lkey resolution:"
lkey="$lkey no-reference-check"
lkey="$lkey stacksize:"
lkey="$lkey synclevel:"
lkey="$lkey threads: openmp: omp:"
lkey="$lkey iopenmp: iomp: io-depth:"
lkey="$lkey truncation:"
lkey="$lkey no-flt noflt no-fast-legendre-transform"
lkey="$lkey flt use-flt useflt use-fast-legendre-transform"
lkey="$lkey executablepath:"
lkey="$lkey wrapper:"
lkey="$lkey noutput: scalar vector"
lkey="$lkey memtrace stktrace: tracestack: perf-stat perf-record"
lkey="$lkey tstep: utstep:"
lkey="$lkey vmax2:"
lkey="$lkey run-directory: dryrun"
lkey="$lkey fdb-directory: fdbdirectory:"
lkey="$lkey keep-fdb"
lkey="$lkey keep-core core no-core"
lkey="$lkey writers: nwriters:"
lkey="$lkey path: verbose"
lkey="$lkey bind: no-bind"
lkey="$lkey tag: hres ens clim"
lkey="$lkey print-level: nprintlev:"
lkey="$lkey gdb"
lkey="$lkey od rd operational research"
lkey="$lkey nhdyn non-hydrostatic"
lkey="$lkey xml keep-xml no-xml"
lkey="$lkey dycore"
lkey="$lkey stochastic places no-places ec-bind: member: totens:"
lkey="$lkey stripe: delay:"
lkey="$lkey cf control-forecast"
lkey="$lkey pf: perturbed-forecast"
lkey="$lkey rst"
lkey="$lkey target: io-bufs:"
lkey="$lkey hello-world"
lkey="$lkey physics:"
lkey="$lkey no-ozone nradint: nsiter:"
lkey="$lkey frequency: cpu-freq: ghz:"
lkey="$lkey ppn:"
lkey="$lkey no-mallocenvs"
lkey="$lkey uniq no-uniq"
lkey="$lkey mp-type: MP_TYPE:"
lkey="$lkey membind"
lkey="$lkey inproot-namelists"
lkey="$lkey nprtrv: nprtrw:"
lkey="$lkey forge-ddt"
lkey="$lkey forge-map"
lkey="$lkey inproot: outroot:"

shiftby=0

#
# Specification of defaults
#
#  The model script uses several variables that control its behaviour
#  to configure the scientific, input, runtime, restart, coupling etc.
#  behaviour of the model. In addition, technical options to control the
#  parallelism and execution mode exist.
#
#  All of these are defined above or in the submodules below, where they
#  are initialized to some default values which can typically be changed
#  with command line options. To support some commonly used model
#  configurations, overwrites for these default values can be provided
#  using the `--defaults <name>` option. Subsequently provided CLI arguments
#  can still be provided to subsequently change these defaults.
#
#  Note that the defaults overwrites are applied immediately upon
#  encountering the `--defaults` option, thus it should be specified as
#  the first argument.
#

# shellcheck source=defaults
source $RAPS_ETCDIR/model/defaults

# Definition of submodules for use in the model script
#
#  Model script submodules can be added by sourcing the relevant file.
#
#  These submodules may define additional variables and corresponding
#  CLI options to change the value of these variables (register their
#  parsing in parse_etc_model below).
#
#  The actual setup should be implemented as one or multiple bash
#  functions inside the submodule that is then called at the appropriate
#  place.
#

# Ocean models (includes NEMO and FESOM setups)
# shellcheck source=ocean
source $RAPS_ETCDIR/model/ocean

# ecWAM wave model
# shellcheck source=wam
source $RAPS_ETCDIR/model/wam

# Forcing options (GHG, ozone, volcanic + tropospheric aerosols, MCC and ICMCL coupling)
# shellcheck source=forcings
source $RAPS_ETCDIR/model/forcings

# restart options
# shellcheck source=restart
source $RAPS_ETCDIR/model/restart

# gpu options
# shellcheck source=gpu
source $RAPS_ETCDIR/model/gpu

# fullpos setup
# shellcheck source=fullpos
source $RAPS_ETCDIR/model/fullpos

# ifs_namelist setup
# shellcheck source=ifs_namelist
source $RAPS_ETCDIR/model/ifs_namelist

# multio setup
# shellcheck source=multio
source $RAPS_ETCDIR/model/multio

# IFS physics options (TOA tuning, convection)
# shellcheck source=ifsphys
source $RAPS_ETCDIR/model/ifsphys

# Register parse methods for modules that define additional options
function parse_etc_model() {
    defaults_parse_opts "$@"
    ocean_parse_opts "$@"
    wam_parse_opts "$@"
    forcings_parse_opts "$@"
    restart_parse_opts "$@"
    gpu_parse_opts "$@"
    fullpos_parse_opts "$@"
    ifs_namelist_parse_opts "$@"
    multio_parse_opts "$@"
    ifsphys_parse_opts "$@"
}

#
# Overwrite default values given the command argument name
#
if [[ "$cmd" = "ens" ]] ; then
    bench=ens
    nemo=1
    lwcou=true
    stochastic=1
elif [[ "$cmd" = "clim" ]] ; then
    bench=clim
    nemo=0
    lwcou=true
    stochastic=0
else
    bench=hres
    nemo=1
    lwcou=true
    stochastic=0
fi

#
# Environment handling
#
#  All environment variables that the model script exports, regardless
#  of whether this is to control IFS behaviour, parallelization, or
#  system behviour (e.g., tuning of communication libraries), should
#  be appended to this array. This provides the ability to inspect
#  the changes that are to be made to the environment.
#
#  For convenience, the function `contains_var` can be used to check
#  if a specific environment variable is contained in the list:
#
#    if contains_var "${env_exports[*]}" "myvar"; then ...
#    if ! contains_var "${env_exports[*]}" "myvar"; then ...
#
env_exports=()

function contains_var() {
    [[ $1 =~ (^|[[:space:]])$2= ]] && return 0 || return 1
}

#
# Parse CLI options
#
rkey=$(echo "$lkey" | perl -pe 's/-//g')

LONG_FLAGS=""
for lf in $(echo "$lkey $rkey" | perl -pe 's/\s+/\n/g'| sort -u)
do
    LONG_FLAGS="$LONG_FLAGS -l $lf"
done

FLAGS="1C:d:D:e:f:FgG:h:H:I:j:J:kl:L:M:n:N:p:P:r:Rs:S:t:T:vuUx:w:W"

OPTS=$(getopt -o $FLAGS $LONG_FLAGS -- "$@")

if [[ $? -ne 0 ]] ; then
    echo "${cmd}: (Error) Invalid or unsupported options from 'getopt'" >&2
    exit 1
fi

trueargs=$(echo "$OPTS" | perl -pe "s/^\s+//; s/(--\S+)\s+'/\${1}=/g; s/'//g; s/--\s*$//")
abort=no

# Check if pigz -- a parallel gzip'per -- is found
pigz=$(which pigz 2>/dev/null || echo "pigz")

eval set -- "$OPTS"

# Add additional binary directories to the PATH for utilities, e.g., ifsnml
PATH="$RAPS_ROOTDIR/etc/contrib/ifsnml/bin:$PATH"
PATH="$RAPS_ROOTDIR/etc/contrib/ecpeak/bin:$PATH"

while true
do
    case "$1" in
	--genref|--refgen|--generate-reference-output|--generatereferenceoutput) lrefgen=true; shift;;
        --ifs-dir) ifs_dir="$2"; shift 2;;
	--reference-input-path|--referenceinputpath) ref_input_path="$2"; shift 2;;
	--cf|--control-forecast|--controlforecast) member=0; shift;; # control forecast
    --clim) nemo=1; bench=clim; stochastic=0; shift;;
	-C|--compiler) compiler="$2"; shift 2;;
    --core) core=1; shift;;
    --no-core) core=0; shift;;
	-d|--datestamp|--yyyymmddzz) yyyymmddzz="$2"; shift 2;;
	--delay) delay="$2"; shift 2;;
	--dryrun) dryrun=1; shift;;
	--dycore) dycore=1; shift;;
    --frequency|--ghz|--cpu-freq|--cpufreq) khz=$(echo "$2" | awk '{printf("%.0f",1000000*$1)}'); shift 2;;
	--ecbind|--ec-bind|--bind) ecbind="$2"; shift 2;;
	--nobind|--no-bind) ecbind=0; shift;;
	-e|--expver|--expid) expver="$2"; shift 2;;
	--outroot) OUTROOT="$2"; shift 2;;
	--outexp) outexp="$2"; shift 2;;
    --ens) nemo=1; bench=ens; stochastic=1; shift;;
	--stochastic) stochastic=1; shift;;
	-f|--fclen|--forecast) fclen="$2"; shift 2;;
	-F|--no-fdb|--nofdb|--icm) lfdbop=false; shift;;
        --fdb-directory|--fdbdirectory) fdbdir=$(readlink -f "$2" || echo "$2"); keepfdb=1; shift 2;;
	--firstout) firstout=$2; shift 2;;
	-g|--gstats) gstats=true; shift;;
	-G|--thread-guardsize|--threadguardsize) thread_guardsize_mb=$2; shift 2;;
	--gp-model-heap|--gpmodelheap)  nopt_memory=0; shift;;
	--gp-model-stack|--gpmodelstack) nopt_memory=1; shift;;
	--gp-model-heap2|--gpmodelheap2)  nopt_memory=2; shift;;
	-h|--ht|--smt) htway=$2; shift 2;;
	-H|--host) host="$2"; shift 2;;
	--launcher) launcher="$2"; shift 2;;
    --inproot) INPROOT="$2"; shift 2;;
	--iobufs|--io-bufs) iobufs=$2; shift 2;;
    --iodevnull|--io-devnull) iodevnull=1; shift;;
	--ionodes) nproc_io_nodes=$2; nproc_io=0; shift 2;;
	-I|--iotasks) nproc_io=$2; nproc_io_nodes=0; shift 2;;
	--ocean-ionodes) ocean_nproc_ionodes=$2; ocean_nproc_io=0; shift 2;;
	--ocean-iotasks) ocean_nproc_io=$2; ocean_nproc_ionodes=0; shift 2;; # io tasks are the number of servers for Multio
	-j|--jobid) jobid="$2"; shift 2;;
	-J|--jobname) jobname="$2"; shift 2;;
	-k|--drhook) drhook=true; shift;;
	--keepfdb|--keep-fdb) keepfdb=1; shift;;
	--keepcore|--keep-core) keepcore=1; shift;; # NB: an implicit --core as well
	--xml|--keepxml|--keep-xml) keepxml=1; noxml=0; coxmldir="io_serv.xml.d"; shift;;
	--no-xml|--noxml) keepxml=0; noxml=1; coxmldir="/dev/null"; shift;;
	-l|--levels) levels=$2; shift 2;;
	-L|--input-data-label|--inputdatalabel|--label) LABEL="$2"; shift 2;;
	--membind) membind=1; shift;;
	--memtrace) memtrace=1; drhook=true; shift;;
	--member|--pf|--perturbed-forecast|--perturbedforecast) member=$(printf "%.0f" "$2"); shift 2;;
	--mptype|--mp-type|--MP_TYPE) mptype="$2"; shift 2;;
	--nhdyn|--non-hydrostatic|--nonhydrostatic) nhdyn=1; shift;;
	-n|--nodes) nodes=$2; shift 2;;
	--noutput) noutput=$2; shift 2;;
	-N|--nproma) nproma=$2; shift 2;;
	--nprintlev|--print-level|--printlevel) nprintlev=$2; shift 2;;
	--nradfr) nradfr="$2"; shift 2;;
	--nradint) nradint=$2; shift 2;;
	--nrproma) nrproma=$2; shift 2;;
	--nsiter) nsiter=$2; shift 2;;
	--nwamproma) nproma_wam=$2; shift 2;;
	--nodrhook|--no-drhook) drhook=off; shift;; # different than drhook=false
	--noradiation|--no-radiation) nradfr="1000000"; leradi=false; shift;;
	--ppout|--outputfrequency|--output-frequency) ppout=$2; iomode="undef"; shift 2;;
	--od|--operational) iomode="od"; ppout=0; lfdbop=true; shift;;
	--rd|--research) iomode="rd"; ppout=0; lfdbop=true; shift;;
	-P|--path) PATH="$2:$PATH"; shift 2;;
	-p|--tasks|--mpi) tasks=$2; shift 2;;
	--perf-stat|--perfstat) perf="ecperf-stat"; shift;;
	--perf-record|--perfrecord) perf="ecperf-record"; shift;;
	--places) places=" --places"; shift;;
	--no-places|--noplaces) places=""; shift;;
	--physics) nemo=0; lwcou=false; physics="$2"; shift 2;; # Also turns NEMO & WAM off ; need --nemo --wam *after* --physics=<string> to re-enable them
	--ppn) ppnin=$2; shift 2;;
	--nprtrw) nprtrw=$2; shift 2;;
	--nprtrv) nprtrv=$2; shift 2;;
	-r|--resolution) resol=$2; shift 2;;
	--run-directory|--rundirectory) rundir=$(readlink -f "$2" || echo "$2"); shift 2;;
	-R|--no-reference-check|--noreferencecheck) lrefout=false; shift;;
	--rst) iomode=rst; ppout=0; shift;;
	-s|--stacksize) stacksize=$2; shift 2;;
	-S|--synclevel) sync_level=$2; shift 2;;
	--scalar) lopt_scalar=true; shift;;
	--stktrace|--tracestack) stktrace="$2"; drhook=true; shift 2;;
